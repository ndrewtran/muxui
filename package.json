{
  "name": "@muxui/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Mux UI monorepo workspace",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "10.33.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check": "node tooling/audits/repository-policy/src/run-workspace-task.mjs check --affected",
    "check:all": "node tooling/audits/repository-policy/src/run-workspace-task.mjs check",
    "generate": "node tooling/audits/repository-policy/src/run-workspace-task.mjs generate",
    "storybook": "pnpm --filter @muxui/react-storybook run storybook",
    "generate:check": "node tooling/audits/repository-policy/src/generation-identity.mjs",
    "test:agent": "node tooling/audits/repository-policy/src/agent-eval-status.mjs",
    "release:prepare": "pnpm check:all && pnpm generate:check && node tooling/audits/repository-policy/src/release-prepare.mjs"
  },
  "devDependencies": {
    "@muxui/catalog": "workspace:*"
  }
}
