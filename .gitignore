.DS_Store
node_modules/
.pnpm-store/
coverage/
dist/
build/
*.log

# Reproducible package and explorer projections are bootstrapped by `pnpm
# generate` and regenerated by checks, builds, and package preparation.
/apps/react-storybook/.storybook/generated/
/packages/catalog/generated/
/packages/react-native/generated/
/packages/react/generated/
/packages/schema/generated/
/packages/tooling/generated/
/packages/web/generated/

# Local agent client state stays untracked; only the shared skills discovery
# link to `.agents/skills` is tracked.
/.claude/*
!/.claude/skills

# Temp directories the R1 exit capture renames into place; a crash may leave one.
/tests/evidence/.*.staging-*
