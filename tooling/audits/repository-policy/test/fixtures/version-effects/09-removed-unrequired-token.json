{
  "row": "Change a public token name incompatibly, where no component binding requires it",
  "patch": [
    {
      "op": "remove",
      "path": "/records/muxui:token:default-theme/record/tokens/semantic.action.foreground"
    },
    {
      "op": "replace",
      "path": "/records/muxui:token:default-theme/record/tokenContractVersion",
