{
  "row": "Add a supported runtime profile",
  "renderers": {
    "web.react": "@muxui/react",
    "native.react-native": "@muxui/react-native"
  },
  "patch": [
    {
      "op": "replace",
      "path": "/records/muxui:component:button/record/bindings/native.react-native/runtimeProfiles/native.react-native-web",
      "value": {
        "strategy": "adapted",
        "lifecycle": "experimental",
        "validationProfile": "native.react-native-web"
      }
    }
  ],
  "expect": {
    "catalog": "minor",
    "renderers": {
      "@muxui/react": "none",
      "@muxui/react-native": "minor"
    },
    "publish": ["@muxui/catalog"]
  }
}
