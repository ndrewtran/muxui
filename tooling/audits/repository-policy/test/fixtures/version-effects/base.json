      },
      "source": "export const Basic = () => <Button>Save</Button>;\n"
    },
    {
      "family": "guide",
      "record": {
        "schemaVersion": "1.0.0",
        "id": "muxui:guide:button-usage",
        "kind": "guide",
        "name": "Button usage",
        "summary": "Portable usage guidance for Button.",
        "lifecycle": "experimental",
        "keywords": ["action", "button"],
        "platforms": ["web.html", "web.react", "native.react-native"],
        "source": "catalog/guides/button-usage.md"
      },
      "source": "# Button usage\n\n## When to use\n\nUse Button for an immediate action.\n\n## Accessibility\n\nGive it an accessible name.\n"
    },
    {
      "family": "capability",
      "record": {
