{
  "records": [
    {
      "family": "component",
      "record": {
        "schemaVersion": "1.0.0",
        "id": "muxui:component:button",
        "kind": "component",
        "name": "Button",
        "summary": "Triggers an immediate action.",
        "lifecycle": "experimental",
        "intent": {
          "useWhen": ["Triggering an immediate action"],
          "avoidWhen": ["Navigating to another location"]
        },
        "anatomy": ["root", "label"],
        "states": ["idle", "disabled"],
        "accessibility": {
          "nameRequired": true,
          "obligations": ["Expose disabled state"]
        },
        "bindings": {
          "web.html": {
            "schemaVersion": "2.0.0",
            "lifecycle": "experimental",
            "strategy": "direct",
            "api": {
              "props": ["disabled"],
              "events": ["activate"],
              "parts": ["root", "label"],
              "defaults": {
                "disabled": false
              }
            },
            "behavior": ["Activation requests one immediate action"],
            "accessibility": ["Expose accessible name and disabled state"],
            "tokenRecipe": {
              "source": "muxui:token:default-theme",
              "requirements": [
                {
                  "token": "semantic.action.background",
                  "requirement": "required"
                }
              ]
            },
            "runtimeProfiles": {}
          },
          "web.react": {
            "schemaVersion": "2.0.0",
            "lifecycle": "experimental",
            "strategy": "direct",
            "api": {
              "props": ["disabled"],
              "events": ["activate"],
              "parts": ["root", "label"],
              "defaults": {
                "disabled": false
              }
            },
            "behavior": ["Activation requests one immediate action"],
            "accessibility": ["Expose accessible name and disabled state"],
            "tokenRecipe": {
              "source": "muxui:token:default-theme",
              "requirements": [
                {
                  "token": "semantic.action.background",
                  "requirement": "required",
                  "fallback": {
                    "kind": "token",
                    "profiles": ["web.react"],
                    "evidenceIds": ["E-G1.0-03"],
                    "token": "semantic.action.border"
                  }
                }
              ]
            },
            "runtimeProfiles": {}
          },
          "native.react-native": {
            "schemaVersion": "2.0.0",
            "lifecycle": "experimental",
            "strategy": "adapted",
            "api": {
              "props": ["disabled"],
              "events": ["activate"],
              "parts": ["root", "label"],
              "defaults": {
                "disabled": false
              }
            },
            "behavior": ["Activation requests one immediate action"],
            "accessibility": ["Expose accessible name and disabled state"],
            "tokenRecipe": {
              "source": "muxui:token:default-theme",
              "requirements": [
                {
                  "token": "semantic.action.background",
                  "requirement": "required"
                }
              ]
            },
            "runtimeProfiles": {
              "ios": {
                "strategy": "adapted",
                "lifecycle": "experimental",
                "validationProfile": "native.ios"
              },
              "android": {
                "strategy": "adapted",
                "lifecycle": "experimental",
                "validationProfile": "native.android"
              },
              "native.react-native-web": {
                "strategy": "unsupported",
                "reason": "No responsible implementation in the first proof artifact."
              }
            }
          }
        }
      }
    },
    {
      "family": "token-source",
      "record": {
        "schemaVersion": "2.1.0",
        "id": "muxui:token:default-theme",
        "kind": "token",
        "name": "Synthetic tokens",
        "summary": "The minimum token source used by the G0.1 proof artifact.",
        "lifecycle": "experimental",
        "tokenContractVersion": "1.1.0",
        "theme": {
          "name": "default",
          "modeAxes": {
            "colorScheme": ["light", "dark"],
            "contrast": ["standard", "more"],
            "motion": ["full", "reduced"],
            "density": ["comfortable", "compact"],
            "direction": ["ltr", "rtl"]
          },
          "defaultModes": {
            "colorScheme": "light",
            "contrast": "standard",
            "motion": "full",
            "density": "comfortable",
            "direction": "ltr"
          },
          "runtimeSwitching": "unavailable"
        },
        "tokens": {
          "reference.color.black": {
            "layer": "reference",
            "type": "color",
            "unit": "hex",
            "meaning": "Black reference value.",
            "overridePolicy": "fixed",
            "value": "#000000"
          },
          "semantic.action.background": {
            "layer": "semantic",
            "type": "color",
            "unit": "hex",
            "meaning": "Immediate action background.",
            "overridePolicy": "theme",
            "alias": "reference.color.black"
          },
          "semantic.action.border": {
            "layer": "semantic",
            "type": "color",
            "unit": "hex",
            "meaning": "Edge of an immediate action.",
            "overridePolicy": "theme",
            "alias": "reference.color.black"
          },
          "semantic.action.foreground": {
            "layer": "semantic",
            "type": "color",
            "unit": "hex",
            "meaning": "Text on an immediate action.",
            "overridePolicy": "theme",
            "alias": "reference.color.black"
          }
        }
      }
    },
    {
      "family": "example",
      "record": {
        "schemaVersion": "1.0.0",
        "id": "muxui:example:button-basic-react",
        "kind": "example",
        "name": "Basic React Button",
        "summary": "The minimum React Button example.",
        "lifecycle": "experimental",
        "binding": {
          "ref": "muxui:component:button#web.react",
          "guidanceImpact": "normative",
