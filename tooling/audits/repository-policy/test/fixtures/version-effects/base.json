  "contracts": {
    "schemaVersion": "3.0.0",
    "queryApiVersion": "2.1.0",
    "querySchemaVersion": "2.1.0"
  },
  "schemas": {
    "component.schema.json": {
      "title": "Component",
      "description": "A component record.",
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "blocked": {
          "not": {
            "$ref": "#/$defs/banned"
          }
        }
      },
      "patternProperties": {
        "^x-": {
          "type": "string"
        }
      },
      "$defs": {
        "banned": {
          "type": "object",
          "required": ["x"]
        },
        "valueOrAlias": {
          "type": "object",
          "not": {
            "required": ["alias", "value"]
          }
        }
      }
    },
    "token-source.schema.json": {
      "title": "Token source",
      "type": "object",
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/token"
          }
        }
      },
      "$defs": {
        "token": {
          "type": "object",
          "required": ["layer"],
          "properties": {
            "layer": {
              "type": "string"
            },
            "meaning": {
              "type": "string"
            }
          }
        }
      }
    },
    "query-envelope.schema.json": {
      "title": "Query response",
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "apiVersion": {
          "enum": ["2.1.0"]
        },
        "data": {
          "type": "object"
        },
        "legacyNote": {
          "type": "string"
        }
      }
    }
  },
  "implementation": {
    "@muxui/schema": "sha256:s1",
    "@muxui/catalog": "sha256:c1",
    "@muxui/tooling": "sha256:t1",
    "@muxui/react": "sha256:r1"
  }
