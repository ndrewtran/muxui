        "meaning": "Forced-colors mode keeps content legible.",
        "boundary": "The component keeps its content visible in forced colors."
      },
      {
        "id": "layout.direction",
        "meaning": "Layout follows the writing direction.",
        "boundary": "The component mirrors in a right-to-left layout."
      }
