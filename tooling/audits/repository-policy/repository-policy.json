{
  "schemaVersion": 1,
  "identityReset": {
    "current": {
      "display": "Mux UI",
      "machine": "muxui",
      "repository": "ndrewtran/muxui",
      "packageScope": "@muxui/",
      "artifactPrefix": "muxui:",
      "cli": "muxui",
      "publicRoots": [".muxui-", "--muxui-", "data-muxui-"],
      "diagnosticsPrefix": "MUXUI_",
      "environmentPrefix": "MUXUI_"
    },
    "allowlistedPaths": [
      "decisions/",
      "tests/evidence/",
      "catalog/react-r1-0/",
      "catalog/tokens/default-theme.json",
      "tests/fixtures/g0.4/",
      "tests/fixtures/g1.0/",
      "tests/fixtures/g1.2/",
      "packages/react-native/test/contract.test.mjs",
      "tooling/audits/repository-policy/src/policy.mjs",
      "tooling/audits/repository-policy/test/repository-policy.test.mjs",
      "packages/schema/schemas/react-r1.schema.json",
      "packages/tooling/test/local-resolver.test.mjs",
      "tooling/audits/repository-policy/src/evidence-verify.mjs",
      "tooling/audits/repository-policy/src/react-aria-family-evaluate.mjs",
      "tooling/audits/repository-policy/src/react-aria-stage1-source-verify.mjs",
      "tooling/audits/repository-policy/test/evidence-integrity.test.mjs"
    ]
  },
  "requiredRootCommands": [
    "check",
    "check:all",
    "docs",
    "generate",
    "generate:check",
    "scale",
    "storybook",
    "test:agent",
    "release:prepare"
  ],
  "majorOwners": [
    { "path": "strategy", "classification": "authority" },
    { "path": "decisions", "classification": "canonical" },
    { "path": "catalog", "classification": "canonical" },
    { "path": "packages", "classification": "source" },
    { "path": "apps", "classification": "projection-source" },
    { "path": "tooling", "classification": "source" },
    { "path": "tests", "classification": "proof" }
  ],
  "projectionPathSegments": [
    "build",
    "coverage",
    "dist",
    "generated"
  ],
  "retainedProjectionFixtureRoots": [
    "tests/fixtures"
  ],
  "slugPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
  "generatedMarkers": {
    "source": "@generated-from:",
    "digest": "@generated-content-sha256:"
  },
  "strictJsonProjections": [
    {
      "path": "packages/catalog/generated/catalog.json",
      "provenance": "packages/catalog/generated/catalog.json.provenance"
    },
    {
      "path": "packages/catalog/generated/catalog-package.json",
      "provenance": "packages/catalog/generated/catalog-package.json.provenance"
    },
    {
      "path": "packages/react/generated/descriptor.json",
      "provenance": "packages/react/generated/descriptor.json.provenance"
    },
    {
      "path": "packages/react/generated/release.json",
      "provenance": "packages/react/generated/release.json.provenance"
    }
  ],
  "globalTaskInputs": [
    ".node-version",
    ".npmrc",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "affectedPathOwners": {
    ".agents/": ["@muxui/repository-policy"],
    ".claude/": ["@muxui/repository-policy"],
    ".github/": ["@muxui/repository-policy"],
    ".gitattributes": ["@muxui/repository-policy"],
    ".gitignore": ["@muxui/repository-policy"],
    "AGENTS.md": ["@muxui/repository-policy"],
    "LICENSE": ["@muxui/repository-policy"],
    "README.md": ["@muxui/repository-policy"],
    "apps/AGENTS.md": ["@muxui/repository-policy"],
    "catalog/": ["@muxui/catalog"],
    "decisions/": ["@muxui/repository-policy"],
    "docs/agents/": ["@muxui/repository-policy"],
    "packages/": ["@muxui/repository-policy"],
    "strategy/": ["@muxui/repository-policy"],
    "tests/": ["@muxui/repository-policy"],
    "tooling/": ["@muxui/repository-policy"]
  },
  "affectedPathConsumers": {
    "apps/component-navigation.mjs": ["@muxui/docs", "@muxui/react-storybook"],
    "apps/scale/src/": ["@muxui/docs"]
  },
  "generationPrerequisites": {
    "@muxui/repository-policy": ["@muxui/react"]
  },
  "pullRequestImpact": {
    "schemaVersion": 1,
    "fullInputPaths": [
      ".node-version",
      ".npmrc",
      "pnpm-workspace.yaml"
    ],
    "policyPrefixes": [
      ".agents/",
      ".claude/",
      ".github/",
      ".gitattributes",
      ".gitignore",
      "AGENTS.md",
      "LICENSE",
      "README.md",
      "apps/AGENTS.md",
      "apps/react-storybook/.gitignore",
      "apps/react-storybook/AGENTS.md",
      "catalog/AGENTS.md",
      "decisions/",
      "docs/agents/",
      "packages/AGENTS.md",
      "strategy/",
      "tests/AGENTS.md",
      "tests/evidence/",
      "tests/fixtures/g0.4/",
      "tests/fixtures/g1.0/",
      "tests/fixtures/g1.2/AGENTS.md",
      "tooling/AGENTS.md",
      "tooling/audits/repository-policy/"
    ],
    "themePrefixes": [
      "catalog/tokens/",
      "packages/foundation/",
      "packages/tokens/"
    ],
    "reactCatalogInputReaders": {
      "catalog/react-r1-0/": {
        "reactGenerator": true,
        "policy": true,
        "packageChecks": ["@muxui/schema"],
        "storybookUnitTests": [
          {
            "file": "test/storybook.test.mjs",
            "names": [
              "private host and exact Mux UI React family projection",
              "every story exposes exactly its canonical Mux UI-owned properties"
            ]
          }
        ]
      },
      "catalog/react-r1-5/": { "reactGenerator": true, "policy": true },
      "catalog/react-r1-6/": { "reactGenerator": true, "policy": true }
    },
    "packageFixtureOwners": {
      "packages/catalog/test/fixtures/": ["@muxui/catalog", "@muxui/tooling"],
      "tests/fixtures/g0.5/": "@muxui/tooling",
      "tests/fixtures/g1.1/": "@muxui/web",
      "tests/fixtures/g1.2/": "@muxui/react-native"
    },
    "packageSourceOwners": {
      "catalog/capabilities/": "@muxui/catalog",
      "catalog/components/": "@muxui/catalog",
      "catalog/guides/": "@muxui/catalog",
      "catalog/patterns/": "@muxui/catalog",
      "catalog/tokens/": "@muxui/tokens",
      "packages/catalog/catalog-sources.json": "@muxui/catalog",
      "packages/tooling/command-registry.json": "@muxui/tooling"
    },
    "patternBrowserTests": {
      "account-settings": "test/browser/pattern-account-settings.test.mjs",
      "company-records": "test/browser/pattern-company-records.test.mjs",
      "marketing-hero": "test/browser/pattern-marketing-hero.test.mjs",
      "poster-grid": "test/browser/pattern-poster-grid.test.mjs",
      "pricing-plans": "test/browser/pattern-pricing-plans.test.mjs",
      "task-filters": "test/browser/pattern-task-filters.test.mjs",
      "workspace-navigation": "test/browser/pattern-workspace-navigation.test.mjs"
    },
    "documentationPrefixes": [
      "apps/docs/",
      "apps/scale/src/"
    ],
    "componentNavigationPaths": [
      "apps/component-navigation.mjs"
    ],
    "reactStylePrefixes": [
      "packages/react/src/styles/",
      "packages/react/src/supplemental/styles.css"
    ],
    "tailwindRelevantPrefixes": [
      "catalog/tokens/",
      "packages/react/src/styles/",
      "packages/react/src/supplemental/",
      "packages/tokens/",
      "tests/fixtures/tailwind-consumer/"
    ],
    "tailwindRelevantPaths": [
      "packages/react/package.json",
      "packages/tokens/package.json"
    ],
    "reactStorybookSharedPaths": [
      "apps/react-storybook/src/storybook-factory.mjs",
      "apps/react-storybook/.storybook/main.mjs",
      "apps/react-storybook/.storybook/measure-palette.mjs",
      "apps/react-storybook/.storybook/preview.css",
      "apps/react-storybook/.storybook/preview.mjs"
    ],
    "reactStorybookGeneratorPaths": [
      "apps/react-storybook/src/generate-stories.mjs"
    ],
    "reactStorybookSelectionPaths": [
      "apps/react-storybook/src/check-scoped.mjs",
      "apps/react-storybook/test/storybook-page-selection.mjs",
      "apps/react-storybook/test/storybook-page-selection.test.mjs",
      "apps/react-storybook/test/storybook-family-selection.mjs",
      "apps/react-storybook/test/storybook-family-selection.test.mjs"
    ],
    "reactStorybookChromePaths": [
      "apps/react-storybook/src/storybook-theme.mjs",
      "apps/react-storybook/.storybook/main.mjs",
      "apps/react-storybook/.storybook/manager.mjs",
      "apps/react-storybook/.storybook/theme.mjs"
    ]
  },
  "toolchain": {
    "node": "24.19.0",
    "nodeRange": ">=24.19.0 <25",
    "pnpm": "10.33.0"
  }
}
