{
  "schemaVersion": 1,
  "identityReset": {
    "current": {
      "display": "Mux UI",
      "machine": "muxui",
      "repository": "ndrewtran/muxui",
      "packageScope": "@muxui/",
      "artifactPrefix": "muxui:",
      "cli": "muxui",
      "publicRoots": [".muxui-", "--muxui-", "data-muxui-"],
      "diagnosticsPrefix": "MUXUI_",
      "environmentPrefix": "MUXUI_"
    },
    "allowlistedPaths": [
      "decisions/",
      "tests/evidence/",
      "strategy/archive/",
      "catalog/react-r1-0/",
      "catalog/tokens/default-theme.json",
      "tests/fixtures/g0.4/",
      "tests/fixtures/g1.0/",
      "tests/fixtures/g1.2/",
      "packages/react-native/test/contract.test.mjs",
      "packages/tokens/fixtures/button-minimum-phase-b.json",
      "tooling/audits/repository-policy/src/policy.mjs",
      "tooling/audits/repository-policy/test/repository-policy.test.mjs",
      "packages/schema/schemas/react-r1.schema.json",
      "packages/tooling/test/local-resolver.test.mjs",
      "tooling/audits/repository-policy/src/delivery-workflow-authority-verify.mjs",
      "tooling/audits/repository-policy/src/evidence-applicability-supersession.mjs",
      "tooling/audits/repository-policy/src/evidence-verify.mjs",
      "tooling/audits/repository-policy/src/g1-2-applicability-continuity-verify.mjs",
      "tooling/audits/repository-policy/src/r1-continuous-authority-compatibility.mjs",
      "tooling/audits/repository-policy/src/react-aria-family-evaluate.mjs",
      "tooling/audits/repository-policy/src/react-aria-stage1-source-verify.mjs",
      "tooling/audits/repository-policy/test/delivery-workflow-authority.test.mjs",
      "tooling/audits/repository-policy/test/evidence-integrity.test.mjs",
      "tooling/audits/repository-policy/test/historical-catalog-compatibility.test.mjs"
    ]
  },
  "requiredRootCommands": [
    "check",
    "check:all",
    "docs",
    "generate",
    "generate:react",
    "generate:check",
    "scale",
    "storybook",
    "test:agent",
    "release:prepare"
  ],
  "majorOwners": [
    { "path": "strategy", "classification": "authority" },
    { "path": "decisions", "classification": "canonical" },
    { "path": "catalog", "classification": "canonical" },
    { "path": "packages", "classification": "source" },
    { "path": "apps", "classification": "projection-source" },
    { "path": "tooling", "classification": "source" },
    { "path": "tests", "classification": "proof" }
  ],
  "projectionPathSegments": [
    "build",
    "coverage",
    "dist",
    "generated"
  ],
  "retainedProjectionFixtureRoots": [
    "tests/fixtures"
  ],
  "slugPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
  "generatedMarkers": {
    "source": "@generated-from:",
    "digest": "@generated-content-sha256:"
  },
  "strictJsonProjections": [
    {
      "path": "packages/catalog/generated/catalog.json",
      "provenance": "packages/catalog/generated/catalog.json.provenance"
    },
    {
      "path": "packages/catalog/generated/catalog-package.json",
      "provenance": "packages/catalog/generated/catalog-package.json.provenance"
    },
    {
      "path": "packages/react/generated/descriptor.json",
      "provenance": "packages/react/generated/descriptor.json.provenance"
    },
    {
      "path": "packages/react/generated/release.json",
      "provenance": "packages/react/generated/release.json.provenance"
    }
  ],
  "generatorProjectionGroups": [
    {
      "id": "muxui-catalog-generation-v1",
      "whenCanonicalSourcePrefixes": ["catalog/"],
      "whenProjectionsInclude": [
        "packages/catalog/generated/catalog.json",
        "packages/catalog/generated/catalog-package.json"
      ],
      "outputs": [
        "packages/catalog/generated/catalog-package.json",
        "packages/catalog/generated/catalog-package.json.provenance",
        "packages/catalog/generated/catalog.json",
        "packages/catalog/generated/catalog.json.provenance",
        "packages/catalog/generated/catalog.mjs"
      ]
    }
  ],
  "globalTaskInputs": [
    ".agents/",
    ".claude/",
    ".github/",
    ".node-version",
    ".npmrc",
    "AGENTS.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "affectedPathOwners": {
    "catalog/": ["@muxui/catalog"],
    "decisions/": ["@muxui/repository-policy"],
    "packages/": ["@muxui/repository-policy"],
    "strategy/": ["@muxui/repository-policy"],
    "tests/": ["@muxui/repository-policy"],
    "tooling/": ["@muxui/repository-policy"]
  },
  "storybookAuditSelection": {
    "schemaVersion": 1,
    "package": "@muxui/react-storybook",
    "fullInputPrefixes": [
      ".agents/",
      ".claude/",
      ".github/",
      "catalog/components/",
      "catalog/react-r1-0/",
      "catalog/react-r1-5/",
      "catalog/react-r1-6/",
      "catalog/tokens/",
      "tooling/audits/repository-policy/"
    ],
    "fullInputPaths": [
      ".node-version",
      ".npmrc",
      "AGENTS.md",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml"
    ],
    "safeUnrelatedPrefixes": [
      "apps/docs/",
      "apps/react-playground/",
      "apps/scale/"
    ],
    "forceFullEvents": [
      "schedule",
      "workflow_dispatch",
      "check:all",
      "release"
    ]
  },
  "pullRequestImpact": {
    "schemaVersion": 1,
    "fullInputPaths": [
      ".node-version",
      ".npmrc",
      "pnpm-workspace.yaml"
    ],
    "policyPrefixes": [
      ".agents/",
      ".claude/",
      ".github/",
      "AGENTS.md",
      "decisions/",
      "strategy/",
      "tooling/AGENTS.md",
      "tooling/audits/repository-policy/"
    ],
    "themePrefixes": [
      "catalog/tokens/",
      "packages/foundation/",
      "packages/tokens/"
    ],
    "documentationPrefixes": [
      "apps/docs/"
    ],
    "reactStylePrefixes": [
      "packages/react/src/styles/",
      "packages/react/src/supplemental/styles.css"
    ],
    "tailwindRelevantPrefixes": [
      "catalog/tokens/",
      "packages/react/src/styles/",
      "packages/react/src/supplemental/",
      "packages/tokens/",
      "tests/fixtures/tailwind-consumer/"
    ],
    "tailwindRelevantPaths": [
      "packages/react/package.json",
      "packages/tokens/package.json"
    ],
    "reactStorybookPath": "apps/react-storybook/",
    "reactStorybookSharedPaths": [
      "apps/react-storybook/src/storybook-factory.mjs",
      "apps/react-storybook/.storybook/preview.mjs"
    ],
    "reactStorybookGeneratorPaths": [
      "apps/react-storybook/src/generate-stories.mjs"
    ],
    "reactStorybookSelectionPaths": [
      "apps/react-storybook/src/check-scoped.mjs",
      "apps/react-storybook/test/storybook-page-selection.mjs",
      "apps/react-storybook/test/storybook-page-selection.test.mjs",
      "apps/react-storybook/test/storybook-family-selection.mjs",
      "apps/react-storybook/test/storybook-family-selection.test.mjs"
    ],
    "reactStorybookChromePaths": [
      "apps/react-storybook/src/storybook-theme.mjs",
      "apps/react-storybook/.storybook/theme.mjs"
    ]
  },
  "dependencyPreparation": {
    "argvTemplate": [
      "pnpm",
      "install",
      "--offline",
      "--frozen-lockfile",
      "--ignore-scripts",
      "--store-dir",
      "<declared-offline-store>"
    ],
    "environmentKeys": [
      "CI",
      "HOME",
      "LANG",
      "LC_ALL",
      "PATH",
      "TMPDIR"
    ],
    "profile": "muxui-dependency-preparation-command-v1",
    "storePlaceholder": "<declared-offline-store>"
  },
  "toolchain": {
    "node": "24.19.0",
    "nodeRange": ">=24.19.0 <25",
    "pnpm": "10.33.0"
  }
}
