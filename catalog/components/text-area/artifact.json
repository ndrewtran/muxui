{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:text-area",
  "kind": "component",
  "name": "TextArea",
  "summary": "Collect multiline text with shared label, description, and validation parts.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Collecting a paragraph or other multiline text value."
    ],
    "avoidWhen": [
      "For short single-line values or structured rich text."
    ]
  },
  "anatomy": [
    "root",
    "textarea",
    "label",
    "description",
    "error"
  ],
  "states": [
    "empty",
    "filled",
    "disabled",
    "invalid",
    "focused"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Uses native textarea attributes and shared Mux field validation semantics."
    ]
  },
  "bindings": {
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "value",
          "defaultValue",
          "rows",
          "maxLength",
          "placeholder",
          "disabled",
          "invalid",
          "required",
          "readOnly",
          "size"
        ],
        "events": [
          "change"
        ],
        "parts": [
          "root",
          "textarea",
          "label",
          "description",
          "error"
        ],
        "defaults": {
          "size": "md",
          "disabled": false,
          "invalid": false,
          "required": false,
          "readOnly": false
        }
      },
      "behavior": [
        "Uses native textarea attributes and shared Mux field validation semantics."
      ],
      "accessibility": [
        "Uses native textarea attributes and shared Mux field validation semantics."
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.feedback",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to the React web binding."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to the React web binding."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
