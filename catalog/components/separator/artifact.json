{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:separator",
  "kind": "component",
  "name": "Separator",
  "summary": "Separates content or controls along an axis.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Visually or semantically separating content"
    ],
    "avoidWhen": [
      "Decorating without a meaningful boundary",
      "A divider that people drag to resize panels; use Resizable"
    ]
  },
  "anatomy": [
    "root"
  ],
  "states": [
    "horizontal",
    "vertical"
  ],
  "accessibility": {
    "nameRequired": false,
    "obligations": [
      "Expose orientation when semantic",
      "Remain perceivable in forced colors"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "strategy": "unsupported",
      "reason": "Parked by Decision 0031: no responsible implementation until W1.0 restores @muxui/web.",
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "system.high-contrast",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "layout.direction",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            }
          ]
        }
      ]
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "behavior": [
        "Orientation controls the logical axis",
        "A semantic separator is exposed to assistive technology",
        "A horizontal Separator renders an hr; a vertical one renders a div with the separator role and aria-orientation set to vertical.",
        "A vertical Separator is 1px wide and takes the height of the flex or grid row it sits in.",
        "A vertical Separator in a block parent, or in a row with nothing else in it, has no height."
      ],
      "accessibility": [
        "Expose separator role and orientation for non-decorative separators"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
