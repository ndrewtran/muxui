{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:group",
  "kind": "component",
  "name": "Group",
  "summary": "Groups related controls under one semantic boundary.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Labeling or grouping related controls"
    ],
    "avoidWhen": [
      "Replacing a form fieldset with a legend"
    ]
  },
  "anatomy": [
    "root",
    "label",
    "content"
  ],
  "states": [
    "idle",
    "disabled",
    "invalid",
    "read-only"
  ],
  "accessibility": {
    "nameRequired": false,
    "obligations": [
      "Expose an appropriate grouping role",
      "Preserve disabled and invalid context"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "disabled",
          "invalid",
          "readOnly",
          "role",
          "aria-label"
        ],
        "events": [],
        "parts": [
          "root",
          "label",
          "content"
        ],
        "defaults": {
          "disabled": false,
          "invalid": false,
          "readOnly": false,
          "role": "group"
        }
      },
      "behavior": [
        "Group state is reflected on the root",
        "Content remains in document order"
      ],
      "accessibility": [
        "Expose group or region role and accessible name when supplied"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.html."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.html."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "disabled",
          "invalid",
          "readOnly",
          "role",
          "aria-label"
        ],
        "events": [],
        "parts": [
          "root",
          "label",
          "content"
        ],
        "defaults": {
          "disabled": false,
          "invalid": false,
          "readOnly": false,
          "role": "group"
        }
      },
      "behavior": [
        "Group state is reflected on the root",
        "Content remains in document order"
      ],
      "accessibility": [
        "Expose group or region role and accessible name when supplied"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
