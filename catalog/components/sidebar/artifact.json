{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:sidebar",
  "kind": "component",
  "name": "Sidebar",
  "summary": "Provide persistent navigation with nested items, account content, and mobile access.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Providing persistent navigation alongside the main application content."
    ],
    "avoidWhen": [
      "For primary top-level navigation or a short list of contextual links."
    ]
  },
  "anatomy": [
    "root",
    "header",
    "search",
    "divider",
    "nav-list",
    "nav-item",
    "nav-button",
    "account-card",
    "account-menu",
    "mobile-trigger",
    "feature-card"
  ],
  "states": [
    "desktop",
    "mobile",
    "current",
    "external",
    "expanded",
    "focused"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Nested nav items use native disclosure semantics.",
      "Mobile navigation traps focus and returns it to the trigger on close."
    ]
  },
  "bindings": {
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "hideBorder",
          "href",
          "current",
          "external",
          "items",
          "badge",
          "icon",
          "placeholder",
          "value",
          "onChange",
          "name",
          "email",
          "avatarSrc",
          "status",
          "onDismiss"
        ],
        "events": [
          "change",
          "dismiss"
        ],
        "parts": [
          "root",
          "header",
          "search",
          "divider",
          "nav-list",
          "nav-item",
          "nav-button",
          "account-card",
          "account-menu",
          "mobile-trigger",
          "feature-card"
        ],
        "defaults": {
          "hideBorder": false,
          "current": false,
          "external": false,
          "placeholder": "Search"
        }
      },
      "behavior": [
        "Nested nav items use native disclosure semantics.",
        "Mobile navigation traps focus and returns it to the trigger on close."
      ],
      "accessibility": [
        "Nested nav items use native disclosure semantics.",
        "Mobile navigation traps focus and returns it to the trigger on close."
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.feedback",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to the React web binding."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to the React web binding."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
