{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:checkbox",
  "kind": "component",
  "name": "Checkbox",
  "summary": "Represents a binary or indeterminate selection.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Selecting or clearing an option"
    ],
    "avoidWhen": [
      "Choosing exactly one option from a set"
    ]
  },
  "anatomy": [
    "root",
    "input",
    "indicator",
    "label"
  ],
  "states": [
    "idle",
    "selected",
    "indeterminate",
    "disabled",
    "invalid"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Expose checked or mixed state",
      "Expose disabled and invalid states"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "strategy": "unsupported",
      "reason": "Parked by Decision 0031: no responsible implementation until W1.0 restores @muxui/web.",
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "system.high-contrast",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "layout.direction",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            }
          ]
        }
      ]
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "checked",
          "defaultChecked",
          "disabled",
          "size",
          "indeterminate",
          "name",
          "required",
          "value",
          "invalid"
        ],
        "events": [
          "change"
        ],
        "parts": [
          "root",
          "input",
          "indicator",
          "label"
        ],
        "defaults": {
          "defaultChecked": false,
          "disabled": false,
          "size": "md",
          "indeterminate": false,
          "invalid": false
        }
      },
      "behavior": [
        "Space toggles selection",
        "indeterminate is separate from checked, and the mixed state shows for as long as it is true.",
        "A toggle calls onChange with the new boolean and never changes indeterminate, so the application derives or clears it.",
        "A checked Checkbox submits its name with its value; an unchecked one submits nothing.",
        "required sets the native required attribute, so native form validation blocks submitting it unchecked.",
        "invalid marks the Checkbox invalid but shows no message: Checkbox has no error or description part.",
        "aria-describedby reaches the native input, so the application can link its own message.",
        "size defaults to md for a standalone Checkbox.",
        "Inside a CheckboxGroup, an omitted size follows the group and an explicit size wins."
      ],
      "accessibility": [
        "Expose checkbox role, checked or mixed state, label, disabled, and invalid state"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.size-md",
            "requirement": "required"
          },
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.selection.track",
            "requirement": "required"
          },
          {
            "token": "component.checkbox.selected-foreground-hover",
            "requirement": "required"
          },
          { "token": "semantic.control.size-sm", "requirement": "required" },
          { "token": "semantic.control.size-md", "requirement": "required" },
          { "token": "semantic.control.size-lg", "requirement": "required" },
          { "token": "component.checkbox.indicator-background", "requirement": "required" },
          { "token": "component.checkbox.indicator-border", "requirement": "required" },
          { "token": "component.checkbox.indicator-border-hover", "requirement": "required" },
          { "token": "component.checkbox.selected-invalid-border", "requirement": "required" },
          { "token": "component.checkbox.invalid-border-hover", "requirement": "required" },
          { "token": "component.checkbox.selected-background", "requirement": "required" },
          { "token": "component.checkbox.selected-foreground", "requirement": "required" }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
