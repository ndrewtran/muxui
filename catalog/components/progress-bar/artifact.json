{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:progress-bar",
  "kind": "component",
  "name": "ProgressBar",
  "summary": "Communicates task completion or indeterminate progress.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Communicating task progress"
    ],
    "avoidWhen": [
      "Showing a static measurement"
    ]
  },
  "anatomy": [
    "root",
    "label",
    "track",
    "fill"
  ],
  "states": [
    "idle",
    "progress",
    "indeterminate",
    "complete"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Expose determinate or indeterminate progress",
      "Expose value and label when determinate"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "value",
          "minValue",
          "maxValue",
          "label"
        ],
        "events": [],
        "parts": [
          "root",
          "label",
          "track",
          "fill"
        ],
        "defaults": {
          "minValue": 0,
          "maxValue": 100
        }
      },
      "behavior": [
        "Determinate values are clamped to the range",
        "Omitted value produces an indeterminate progressbar",
        "Determinate completion is exposed when value reaches or exceeds maxValue"
      ],
      "accessibility": [
        "Expose progressbar role and value semantics without continuous motion"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.selection.track",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.feedback",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.html."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.html."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "value",
          "minValue",
          "maxValue",
          "label"
        ],
        "events": [],
        "parts": [
          "root",
          "label",
          "track",
          "fill"
        ],
        "defaults": {
          "minValue": 0,
          "maxValue": 100
        }
      },
      "behavior": [
        "Determinate values are clamped to the range",
        "Omitted value produces an indeterminate progressbar",
        "Determinate completion is exposed when value reaches or exceeds maxValue"
      ],
      "accessibility": [
        "Expose progressbar role and value semantics without continuous motion"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.selection.track",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.feedback",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
