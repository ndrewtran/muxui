{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:button",
  "kind": "component",
  "name": "Button",
  "summary": "Triggers an immediate action.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": ["Triggering an immediate action"],
    "avoidWhen": ["Navigating to another location"]
  },
  "anatomy": ["root", "label"],
  "states": ["idle", "pending", "disabled"],
  "accessibility": {
    "nameRequired": true,
    "obligations": ["Expose disabled state", "Expose pending busy state"]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "strategy": "unsupported",
      "reason": "Parked by Decision 0031: no responsible implementation until W1.0 restores @muxui/web.",
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "system.high-contrast",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "layout.direction",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            }
          ]
        }
      ]
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": ["disabled", "pending", "showTextWhileLoading", "variant", "size"],
        "events": ["activate"],
        "parts": ["root", "label"],
        "defaults": {
          "disabled": false,
          "pending": false,
          "showTextWhileLoading": false,
          "variant": "primary",
          "size": "md"
        }
      },
      "behavior": [
        "Activation requests one immediate action",
        "Pending suppresses activation while retaining focusability",
        "Variant and size select finite visual recipes",
        "showTextWhileLoading keeps the pending label visible beside its spinner",
        "The ref resolves to the native HTMLButtonElement; native pointer, pointer capture, auxiliary click, and context-menu handlers run on that host. Consumers may capture and release pointers without replacing onActivate."
      ],
      "accessibility": ["Expose accessible name, disabled state, and busy state"],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          { "token": "component.button.background", "requirement": "required" },
          { "token": "component.button.foreground", "requirement": "required" },
          { "token": "component.button.min-height", "requirement": "required" },
          { "token": "component.button.padding-inline", "requirement": "required" },
          { "token": "component.button.radius", "requirement": "required" },
          { "token": "semantic.control.size-sm", "requirement": "required" },
          { "token": "semantic.control.size-md", "requirement": "required" },
          { "token": "semantic.control.size-lg", "requirement": "required" },
          { "token": "semantic.action.neutral-background", "requirement": "required" },
          { "token": "semantic.action.neutral-background-hover", "requirement": "required" },
          { "token": "semantic.action.neutral-background-pressed", "requirement": "required" },
          { "token": "semantic.action.background-hover", "requirement": "required" },
          { "token": "semantic.action.background-pressed", "requirement": "required" },
          { "token": "component.button.danger-ghost-foreground", "requirement": "required" },
          { "token": "component.button.danger-neutral-foreground", "requirement": "required" },
          { "token": "semantic.motion.interaction-transition", "requirement": "required" }
        ]
      },
    "platformSafety": [
      {
        "profile": "web.react",
        "requirements": [
          { "id": "system.forced-colors", "disposition": "required" },
          { "id": "system.high-contrast", "disposition": "required" },
          { "id": "native.dynamic-color", "disposition": "not-applicable", "reason": "Native dynamic colors do not apply to the React web binding." },
          { "id": "native.font-metrics", "disposition": "not-applicable", "reason": "Native font metrics do not apply to the React web binding." },
          { "id": "layout.direction", "disposition": "required" },
          { "id": "platform.accessibility-mapping", "disposition": "required" }
        ]
      }
    ],
    "runtimeProfiles": {}
    },
    "native.react-native": {
      "schemaVersion": "2.0.0",
      "strategy": "unsupported",
      "reason": "Parked by Decision 0031: no responsible implementation until N1.0 restores @muxui/react-native.",
      "platformSafety": [
        {
          "profile": "native.react-native",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "not-applicable",
              "reason": "native.react-native is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "system.high-contrast",
              "disposition": "not-applicable",
              "reason": "native.react-native is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "native.react-native is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "native.react-native is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "layout.direction",
              "disposition": "not-applicable",
              "reason": "native.react-native is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "not-applicable",
              "reason": "native.react-native is unsupported, so no platform-safety requirement applies."
            }
          ]
        }
      ]
    }
  }
}
