{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:link",
  "kind": "component",
  "name": "Link",
  "summary": "Navigates to another location or resource.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Navigating to another location"
    ],
    "avoidWhen": [
      "Triggering an immediate action"
    ]
  },
  "anatomy": [
    "root",
    "label"
  ],
  "states": [
    "idle",
    "current",
    "disabled",
    "pressed"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Expose link semantics and destination",
      "Expose current and disabled states"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "strategy": "unsupported",
      "reason": "Parked by Decision 0031: no responsible implementation until W1.0 restores @muxui/web.",
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "system.high-contrast",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "layout.direction",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            }
          ]
        }
      ]
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "href",
          "disabled",
          "current",
          "target",
          "rel"
        ],
        "events": [
          "activate"
        ],
        "parts": [
          "root",
          "label"
        ],
        "defaults": {
          "disabled": false,
          "current": false
        }
      },
      "behavior": [
        "Enter activates an enabled link",
        "Disabled links suppress navigation and remain perceivable",
        "A Link without an href, or with an empty one, is disabled even when disabled is false.",
        "A disabled Link renders as a span with the link role, not as an anchor.",
        "onActivate runs when an enabled Link is activated, in addition to following href; it does not replace href.",
        "A disabled Link does not call onActivate."
      ],
      "accessibility": [
        "Expose link role, destination, current state, and disabled state"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.interaction-transition",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.state-transition",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
