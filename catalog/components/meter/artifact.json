{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:meter",
  "kind": "component",
  "name": "Meter",
  "summary": "Displays a scalar measurement within a known range.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Showing a non-changing measurement"
    ],
    "avoidWhen": [
      "Showing task completion progress"
    ]
  },
  "anatomy": [
    "root",
    "label",
    "track",
    "fill"
  ],
  "states": [
    "idle"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Expose value, minimum, maximum, and label"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "value",
          "minValue",
          "maxValue",
          "label",
          "formatOptions"
        ],
        "events": [],
        "parts": [
          "root",
          "label",
          "track",
          "fill"
        ],
        "defaults": {
          "value": 0,
          "minValue": 0,
          "maxValue": 100
        }
      },
      "behavior": [
        "Values are clamped to the declared range",
        "Fill reflects the normalized percentage"
      ],
      "accessibility": [
        "Expose meter role, value range, value text, and accessible name"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.selection.track",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.html."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.html."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "value",
          "minValue",
          "maxValue",
          "label",
          "formatOptions"
        ],
        "events": [],
        "parts": [
          "root",
          "label",
          "track",
          "fill"
        ],
        "defaults": {
          "value": 0,
          "minValue": 0,
          "maxValue": 100
        }
      },
      "behavior": [
        "Values are clamped to the declared range",
        "Fill reflects the normalized percentage"
      ],
      "accessibility": [
        "Expose meter role, value range, value text, and accessible name"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.selection.track",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
