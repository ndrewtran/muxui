{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:tag-select",
  "kind": "component",
  "name": "TagSelect",
  "summary": "Choose multiple collection items while keeping selected values visible as tags.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Selecting several predefined values that stay visible as removable tags"
    ],
    "avoidWhen": [
      "Free-form values; use InputTags",
      "One choice; use ComboBox",
      "Many selected values that would overwhelm the field; use MultiSelect"
    ]
  },
  "anatomy": [
    "root",
    "label",
    "combobox",
    "group",
    "tag",
    "tag-text",
    "tag-remove",
    "input",
    "listbox",
    "item",
    "description",
    "error"
  ],
  "states": [
    "empty",
    "filtered",
    "selected",
    "disabled",
    "invalid",
    "focused"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Filters unselected items, adds selected IDs, and removes tags without exposing upstream key types."
    ]
  },
  "bindings": {
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "behavior": [
        "Filters unselected items, adds selected IDs, and removes tags without exposing upstream key types."
      ],
      "accessibility": [
        "Filters unselected items, adds selected IDs, and removes tags without exposing upstream key types."
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.state-transition",
            "requirement": "required"
          },
          { "token": "semantic.control.size-sm", "requirement": "required" },
          { "token": "semantic.control.size-md", "requirement": "required" },
          { "token": "semantic.control.size-lg", "requirement": "required" },
          { "token": "semantic.motion.reveal-transition", "requirement": "required" },
          { "token": "semantic.motion.dismiss-transition", "requirement": "required" },
          { "token": "semantic.motion.interaction-transition", "requirement": "required" }
        ]
      },
      "runtimeProfiles": {}
    }
  }
}
