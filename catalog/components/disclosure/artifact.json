{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:disclosure",
  "kind": "component",
  "name": "Disclosure",
  "summary": "Reveals or hides a related content panel.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Progressively revealing related content"
    ],
    "avoidWhen": [
      "Navigating to a different page"
    ]
  },
  "anatomy": [
    "root",
    "trigger",
    "panel"
  ],
  "states": [
    "collapsed",
    "expanded",
    "disabled"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Associate trigger and panel",
      "Expose expanded and disabled states"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "expanded",
          "defaultExpanded",
          "disabled",
          "id"
        ],
        "events": [
          "expandedChange"
        ],
        "parts": [
          "root",
          "trigger",
          "panel"
        ],
        "defaults": {
          "expanded": false,
          "defaultExpanded": false,
          "disabled": false
        }
      },
      "behavior": [
        "Enter and Space toggle the panel",
        "Expanded state is controllable or internally managed"
      ],
      "accessibility": [
        "Expose a labelled button with expanded state and a controlled panel relationship"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.html."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.html."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "expanded",
          "defaultExpanded",
          "disabled",
          "id"
        ],
        "events": [
          "expandedChange"
        ],
        "parts": [
          "root",
          "trigger",
          "panel"
        ],
        "defaults": {
          "expanded": false,
          "defaultExpanded": false,
          "disabled": false
        }
      },
      "behavior": [
        "Enter and Space toggle the panel",
        "Expanded state is controllable or internally managed"
      ],
      "accessibility": [
        "Expose a labelled button with expanded state and a controlled panel relationship"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.action.neutral-background",
            "requirement": "required"
          },
          {
            "token": "semantic.action.neutral-background-hover",
            "requirement": "required"
          },
          {
            "token": "semantic.action.neutral-background-pressed",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
