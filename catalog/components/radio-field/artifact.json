{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:radio-field",
  "kind": "component",
  "name": "RadioField",
  "summary": "Choose one option from a surrounding radio group with supporting validation text.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Capturing one choice from a mutually exclusive set of options."
    ],
    "avoidWhen": [
      "For independent settings or when several choices may be selected."
    ]
  },
  "anatomy": [
    "root",
    "button",
    "indicator",
    "dot",
    "description",
    "error"
  ],
  "states": [
    "unselected",
    "selected",
    "disabled",
    "invalid",
    "focused"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Root requires a stable string value while the surrounding RadioGroup owns selection changes and roving keyboard focus."
    ]
  },
  "bindings": {
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "size",
          "disabled",
          "invalid",
          "required",
          "readOnly",
          "value"
        ],
        "events": [],
        "parts": [
          "root",
          "button",
          "indicator",
          "dot",
          "description",
          "error"
        ],
        "defaults": {
          "size": "md",
          "disabled": false,
          "invalid": false,
          "required": false,
          "readOnly": false
        }
      },
      "behavior": [
        "Root requires a stable string value while the surrounding RadioGroup owns selection changes and roving keyboard focus."
      ],
      "accessibility": [
        "Root requires a stable string value while the surrounding RadioGroup owns selection changes and roving keyboard focus."
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.feedback",
            "requirement": "required"
          },
          { "token": "semantic.control.size-sm", "requirement": "required" },
          { "token": "semantic.control.size-md", "requirement": "required" },
          { "token": "semantic.control.size-lg", "requirement": "required" }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to the React web binding."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to the React web binding."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
