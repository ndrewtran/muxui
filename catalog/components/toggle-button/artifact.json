{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:toggle-button",
  "kind": "component",
  "name": "ToggleButton",
  "summary": "Toggles a persistent selected state.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Toggling a persistent mode or option"
    ],
    "avoidWhen": [
      "Triggering a one-time immediate action; use Button",
      "Turning a setting on or off on a settings surface; use Switch",
      "Selecting an option to submit with a form; use Checkbox"
    ]
  },
  "anatomy": [
    "root",
    "label"
  ],
  "states": [
    "idle",
    "selected",
    "disabled",
    "pressed"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Expose pressed state",
      "Expose disabled state"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "strategy": "unsupported",
      "reason": "Parked by Decision 0031: no responsible implementation until W1.0 restores @muxui/web.",
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "system.high-contrast",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "layout.direction",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "not-applicable",
              "reason": "web.html is unsupported, so no platform-safety requirement applies."
            }
          ]
        }
      ]
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "selected",
          "defaultSelected",
          "disabled",
          "size"
        ],
        "events": [
          "change",
          "activate"
        ],
        "parts": [
          "root",
          "label"
        ],
        "defaults": {
          "selected": false,
          "defaultSelected": false,
          "disabled": false,
          "size": "md"
        }
      },
      "behavior": [
        "Enter and Space toggle selection",
        "Selection is either controlled by the application or managed by the component",
        "size must be sm, md, or lg, or ToggleButton throws a TypeError",
        "Outside a ToggleButtonGroup, size defaults to md",
        "Inside a ToggleButtonGroup, a ToggleButton without size takes the size of the group, and a size on the ToggleButton takes precedence"
      ],
      "accessibility": [
        "Expose button role, pressed state, accessible name, and disabled state"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.action.background",
            "requirement": "required"
          },
          {
            "token": "semantic.action.foreground",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          { "token": "semantic.control.size-sm", "requirement": "required" },
          { "token": "semantic.control.size-md", "requirement": "required" },
          { "token": "semantic.control.size-lg", "requirement": "required" }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
