{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:disclosure-group",
  "kind": "component",
  "name": "DisclosureGroup",
  "summary": "Coordinates expansion across related disclosures.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Managing a set of related disclosures",
      "Related sections that people may read together or compare, such as FAQ answers"
    ],
    "avoidWhen": [
      "Unrelated independent panels; use Disclosure",
      "Alternative views of one subject shown one at a time; use Tabs"
    ]
  },
  "anatomy": [
    "root",
    "disclosure"
  ],
  "states": [
    "idle",
    "expanded",
    "disabled"
  ],
  "accessibility": {
    "nameRequired": false,
    "obligations": [
      "Coordinate expanded keys",
      "Preserve each disclosure trigger relationship"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "strategy": "unsupported",
      "reason": "No framework-free web implementation exists. Use the web.react binding."
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "behavior": [
        "Group state coordinates child Disclosure instances",
        "expandedIds and defaultExpandedIds list the id of each expanded child Disclosure, so give every child a stable id",
        "While a Disclosure is inside the group, the group owns its expansion and the child's own expanded and defaultExpanded are ignored",
        "onExpandedChange receives the expanded ids as an array of strings",
        "When multiple is false, at most one Disclosure is expanded: expanding another collapses the open one",
        "A Disclosure that is a direct child of the group gets the grouped styling; one wrapped in another element stays in the group without it"
      ],
      "accessibility": [
        "Preserve each child disclosure accessible relationship and state"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.padding-block",
            "requirement": "required"
          },
          {
            "token": "semantic.control.size-md",
            "requirement": "required"
          },
          {
            "token": "semantic.layout.group-gap",
            "requirement": "required"
          },
          {
            "token": "semantic.action.neutral-background",
            "requirement": "required"
          },
          {
            "token": "component.disclosuregroup.background",
            "requirement": "required"
          },
          {
            "token": "semantic.action.neutral-background-hover",
            "requirement": "required"
          },
          {
            "token": "component.disclosuregroup.icon-size",
            "requirement": "required"
          },
          {
            "token": "component.disclosuregroup.label-gap",
            "requirement": "required"
          },
          {
            "token": "component.disclosuregroup.radius",
            "requirement": "required"
          },
          {
            "token": "component.disclosuregroup.motion-duration",
            "requirement": "required"
          },
          {
            "token": "component.disclosuregroup.transition",
            "requirement": "required"
          }
        ]
      },
      "runtimeProfiles": {}
    }
  }
}
