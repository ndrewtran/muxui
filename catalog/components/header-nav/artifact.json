{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:header-nav",
  "kind": "component",
  "name": "HeaderNav",
  "summary": "Provide responsive primary navigation with current-page state and a mobile drawer.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Providing the primary navigation for a site or application shell."
    ],
    "avoidWhen": [
      "For persistent secondary navigation or a dense product sidebar."
    ]
  },
  "anatomy": [
    "root",
    "logo",
    "nav-button",
    "actions",
    "secondary",
    "mobile-trigger"
  ],
  "states": [
    "desktop",
    "mobile",
    "current",
    "focused"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Current links expose aria-current=page.",
      "Mobile navigation traps focus and returns it to the trigger on close."
    ]
  },
  "bindings": {
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "href",
          "current",
          "aria-label"
        ],
        "events": [],
        "parts": [
          "root",
          "logo",
          "nav-button",
          "actions",
          "secondary",
          "mobile-trigger"
        ],
        "defaults": {
          "current": false
        }
      },
      "behavior": [
        "Current links expose aria-current=page.",
        "Mobile navigation traps focus and returns it to the trigger on close."
      ],
      "accessibility": [
        "Current links expose aria-current=page.",
        "Mobile navigation traps focus and returns it to the trigger on close."
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.feedback",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to the React web binding."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to the React web binding."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
