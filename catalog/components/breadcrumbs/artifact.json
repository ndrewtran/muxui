{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:breadcrumbs",
  "kind": "component",
  "name": "Breadcrumbs",
  "summary": "Shows the current location within a navigation hierarchy.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Showing a page location within a hierarchy"
    ],
    "avoidWhen": [
      "Replacing primary navigation"
    ]
  },
  "anatomy": [
    "root",
    "list",
    "item",
    "link"
  ],
  "states": [
    "idle",
    "disabled",
    "current"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Expose navigation landmark and current page",
      "Preserve logical reading and focus order"
    ]
  },
  "bindings": {
    "web.html": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "items",
          "aria-label"
        ],
        "events": [
          "navigate"
        ],
        "parts": [
          "root",
          "list",
          "item",
          "link"
        ],
        "defaults": {
          "items": [],
          "aria-label": "Breadcrumbs"
        }
      },
      "behavior": [
        "Items render in source order",
        "The current item is derived from the final item and is not an activation target",
        "Disabled items are not activation targets"
      ],
      "accessibility": [
        "Expose a navigation landmark, accessible name, current page, and disabled state"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.html",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.html."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.html."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    },
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "items",
          "aria-label"
        ],
        "events": [
          "navigate"
        ],
        "parts": [
          "root",
          "list",
          "item",
          "link"
        ],
        "defaults": {
          "items": [],
          "aria-label": "Breadcrumbs"
        }
      },
      "behavior": [
        "Items render in source order",
        "The current item is derived from the final item and is not an activation target",
        "Disabled items are not activation targets"
      ],
      "accessibility": [
        "Expose a navigation landmark, accessible name, current page, and disabled state"
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.padding-inline",
            "requirement": "required"
          },
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to web.react."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to web.react."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
