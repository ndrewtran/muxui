{
  "schemaVersion": "1.0.0",
  "id": "muxui:component:alert-dialog",
  "kind": "component",
  "name": "AlertDialog",
  "summary": "Confirm a destructive or high-impact action in a modal alert.",
  "lifecycle": "experimental",
  "intent": {
    "useWhen": [
      "Confirming an action that cannot be undone or needs explicit acknowledgement."
    ],
    "avoidWhen": [
      "For routine choices, non-blocking notices, or forms with several fields."
    ]
  },
  "anatomy": [
    "root",
    "trigger",
    "backdrop",
    "popup",
    "content",
    "title",
    "description",
    "actions",
    "close"
  ],
  "states": [
    "closed",
    "open",
    "focused",
    "disabled"
  ],
  "accessibility": {
    "nameRequired": true,
    "obligations": [
      "Escape and backdrop dismissal follow React Aria modal semantics.",
      "Close returns focus to the trigger."
    ]
  },
  "bindings": {
    "web.react": {
      "schemaVersion": "2.0.0",
      "lifecycle": "experimental",
      "strategy": "direct",
      "api": {
        "props": [
          "open",
          "defaultOpen",
          "onOpenChange",
          "disabled",
          "onActivate"
        ],
        "events": [
          "openChange",
          "activate"
        ],
        "parts": [
          "root",
          "trigger",
          "backdrop",
          "popup",
          "content",
          "title",
          "description",
          "actions",
          "close"
        ],
        "defaults": {
          "defaultOpen": false,
          "disabled": false
        }
      },
      "behavior": [
        "Escape and backdrop dismissal follow React Aria modal semantics.",
        "Close returns focus to the trigger."
      ],
      "accessibility": [
        "Escape and backdrop dismissal follow React Aria modal semantics.",
        "Close returns focus to the trigger."
      ],
      "tokenRecipe": {
        "source": "muxui:token:default-theme",
        "requirements": [
          {
            "token": "semantic.control.radius",
            "requirement": "required"
          },
          {
            "token": "semantic.focus.ring",
            "requirement": "required"
          },
          {
            "token": "semantic.motion.feedback",
            "requirement": "required"
          }
        ]
      },
      "platformSafety": [
        {
          "profile": "web.react",
          "requirements": [
            {
              "id": "system.forced-colors",
              "disposition": "required"
            },
            {
              "id": "system.high-contrast",
              "disposition": "required"
            },
            {
              "id": "native.dynamic-color",
              "disposition": "not-applicable",
              "reason": "Native dynamic colors do not apply to the React web binding."
            },
            {
              "id": "native.font-metrics",
              "disposition": "not-applicable",
              "reason": "Native font metrics do not apply to the React web binding."
            },
            {
              "id": "layout.direction",
              "disposition": "required"
            },
            {
              "id": "platform.accessibility-mapping",
              "disposition": "required"
            }
          ]
        }
      ],
      "runtimeProfiles": {}
    }
  }
}
