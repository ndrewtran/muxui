  "types": [
    {
      "id": "mux-provider#MuxProviderProps",
      "name": "MuxProviderProps",
      "module": "mux-provider",
      "public": [
        { "entry": ".", "name": "MuxProviderProps" }
      ],
      "owner": "package-level",
      "text": "type MuxProviderProps = {\n  locale?: string;\n  navigate?: (href: string) => void;\n  useHref?: (href: string) => string;\n  children?: React.ReactNode;\n};",
      "members": [
        {
          "name": "locale",
          "optional": true,
          "type": "string",
          "doc": "The BCP 47 language tag components format numbers and dates in and read their text direction from, such as `de-DE`\nor `ar-EG`. Pass the same value on the server and the client so the markup hydrates unchanged. Without it,\ncomponents render `en-US` on the server and switch to the browser's language after hydration."
        },
        {
          "name": "navigate",
          "optional": true,
          "type": "(href: string) => void",
          "doc": "Opens the `href` of a `Link` or a breadcrumb in place of a browser navigation. Pass a router's navigate function so\nthose links change the route without a page load. Modified clicks, such as opening in a new tab, still reach the\nbrowser."
        },
        {
          "name": "useHref",
          "optional": true,
          "type": "(href: string) => string",
          "doc": "Turns a link's `href` into the URL the browser shows, such as a router's base path joined to it. It runs as a hook."
        },
        { "name": "children", "optional": true, "type": "React.ReactNode" }
      ]
    },
