      "id": "command-palette#CommandPaletteItemOwnProps",
      "name": "CommandPaletteItemOwnProps",
      "module": "command-palette",
      "text": "type CommandPaletteItemOwnProps = {\n  id?: string;\n  title?: string;\n  description?: string;\n  textValue?: string;\n  href?: string;\n  target?: string;\n  disabled?: boolean;\n  closeOnSelect?: boolean;\n  onActivate?: (event: { id?: string }) => void;\n};",
      "members": [
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "doc": "The item's key, which onActivate reports."
        },
        {
          "name": "title",
          "optional": true,
          "type": "string",
          "doc": "The visible title, which also names the item for typeahead."
        },
        {
          "name": "description",
          "optional": true,
          "type": "string",
          "doc": "Supporting text shown under the title."
        },
        {
          "name": "textValue",
          "optional": true,
          "type": "string",
          "doc": "The text typeahead matches when the item has no title."
        },
        {
          "name": "href",
          "optional": true,
          "type": "string",
          "doc": "Makes the item a link to this address."
        },
        {
          "name": "target",
          "optional": true,
          "type": "string",
          "doc": "Where the link opens, as the anchor's target attribute."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "doc": "Marks the item disabled: it cannot be activated."
        },
        {
          "name": "closeOnSelect",
          "optional": true,
          "type": "boolean",
          "doc": "Whether activating this item closes the palette. It follows the root's closeOnSelect when unset."
        },
        {
          "name": "onActivate",
          "optional": true,
          "type": "(event: { id?: string }) => void",
          "doc": "Called with the item's id when the item is activated."
        }
      ]
    },
