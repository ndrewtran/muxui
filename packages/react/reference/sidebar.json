      "id": "menu#MenuListOwnProps",
      "name": "MenuListOwnProps",
      "module": "menu",
      "text": "type MenuListOwnProps = {\n  items?: MuxUIItems;\n  disabled?: boolean;\n  shouldCloseOnSelect?: boolean;\n  onAction?: (item?: MuxUICollectionItem) => void;\n  onSelect?: (item?: MuxUICollectionItem) => void;\n};",
      "members": [
        {
          "name": "items",
          "optional": true,
          "type": "MuxUIItems",
          "refs": ["collection-items#MuxUIItems"],
          "doc": "The options as data: strings, or items with an `id`, a `label`, a `textValue`, and `disabled`. Children take precedence: when both are supplied, the items are not rendered."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "doc": "Disables every item and stops the action callbacks. An item's own `disabled={false}` cannot re-enable it under a disabled list."
        },
        {
          "name": "shouldCloseOnSelect",
          "optional": true,
          "type": "boolean",
          "doc": "Whether choosing an item closes the menu, in place of the root's setting. A Menu.Item can still set its own."
        },
        {
          "name": "onAction",
          "optional": true,
          "type": "(item?: MuxUICollectionItem) => void",
          "refs": ["collection-items#MuxUICollectionItem"],
          "doc": "Called when the user activates an item. A list built from `items` passes the item record; one built from children passes the identity fields `id`, `key`, and `value`. It is not called for a disabled item or while the list is disabled."
        },
        {
          "name": "onSelect",
          "optional": true,
          "type": "(item?: MuxUICollectionItem) => void",
          "refs": ["collection-items#MuxUICollectionItem"],
          "doc": "Called with the same item as `onAction`, right after it."
        }
      ],
      "refs": ["collection-items#MuxUIItems", "collection-items#MuxUICollectionItem"]
    },
