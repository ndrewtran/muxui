{
  "name": "@muxui/react",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndrewtran/muxui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ndrewtran/muxui/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/ndrewtran/muxui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <27"
  },
  "files": [
    "generated",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json",
    "licenses"
  ],
  "sideEffects": [
    "*.css"
  ],
  "muxUi": {
    "rendererDescriptor": "./generated/renderer-descriptor.json"
  },
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "default": "./generated/index.mjs"
    },
    "./compatibility": "./generated/compatibility.mjs",
    "./styles.css": "./generated/styles.css",
    "./themes": {
      "types": "./generated/themes.d.ts",
      "default": "./generated/themes.mjs"
    },
    "./themes.css": "./generated/themes.css",
    "./themes-apca.css": "./generated/themes-apca.css",
    "./testing": "./generated/testing.mjs",
    "./text-editor": {
      "types": "./generated/text-editor.d.ts",
      "default": "./generated/text-editor.js"
    },
    "./markdown": {
      "types": "./generated/markdown.d.ts",
      "default": "./generated/markdown.js"
    }
  },
  "scripts": {
    "prepack": "pnpm --filter @muxui/react^... generate && node src/generate.mjs",
    "prepublishOnly": "node src/publish-guard.mjs",
    "check": "node src/generate.mjs --check && node --test 'test/*.test.mjs' && tsc --noEmit -p test/tsconfig.json",
    "check:types": "node --test test/api-extraction.test.mjs test/declaration-reference.test.mjs test/generic-types-mutations.test.mjs test/reference-reader.test.mjs test/declaration-validity.test.mjs test/consumer-tsc.test.mjs",
    "check:rest": "node src/generate.mjs --check && node --test 'test/!(api-extraction|declaration-reference|generic-types-mutations|reference-reader|declaration-validity|consumer-tsc).test.mjs' && tsc --noEmit -p test/tsconfig.json",
    "check:browser": "node --test --test-concurrency=1 test/browser/*.test.mjs",
    "generate": "node src/generate.mjs",
    "generate:check": "node src/generate.mjs --check"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "lucide-react": "1.37.0",
    "marked": "13.0.3",
    "motion": "13.4.0",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "shiki": "4.5.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@muxui/schema": "workspace:*",
    "@muxui/tokens": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "vite": "8.2.1"
  }
}
