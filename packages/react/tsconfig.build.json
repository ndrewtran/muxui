{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "stripInternal": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "newLine": "lf",
    "rootDir": "src",
    "outDir": "build/ts"
  },
  "include": ["src/**/*.ts", "types/*.d.ts"],
  "exclude": ["src/**/*.d.ts"]
}
