{
  "name": "@muxui/tokens",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./core": "./src/core.mjs",
    "./authoring": "./src/authoring.mjs",
    "./tailwind": "./src/tailwind.mjs",
    "./identity-migration": "./src/default-theme-identity-migration.mjs",
    "./materialization": "./src/tale-token-materialization.mjs"
  },
  "dependencies": {
    "@muxui/schema": "workspace:*",
    "culori": "4.0.2"
  },
  "scripts": {
    "check": "node src/generate.mjs --check && node --test test/*.test.mjs",
    "generate": "node src/generate.mjs",
    "generate:check": "node src/generate.mjs --check",
    "audit:materialization": "node src/tale-token-materialization.mjs --audit",
    "audit:identity": "node src/default-theme-identity-migration.mjs --audit"
  }
}
