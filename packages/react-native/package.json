{
  "name": "@muxui/react-native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./ios": {
      "types": "./src/platform.ios.d.ts",
      "default": "./src/platform.ios.mjs"
    },
    "./android": {
      "types": "./src/platform.android.d.ts",
      "default": "./src/platform.android.mjs"
    },
    "./profiles": {
      "types": "./src/profiles.d.mts",
      "default": "./src/profiles.mjs"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "default": "./generated/native-themes.mjs"
    }
  },
  "scripts": {
    "prepack": "pnpm --filter @muxui/catalog... generate && pnpm generate",
    "check": "node src/generate.mjs --check && node --test ../../tests/fixtures/g1.2/profile.test.mjs test/contract.test.mjs && jest --config test/jest.config.cjs --runInBand --verbose && tsc --noEmit -p test/tsconfig.json",
    "generate": "node src/generate.mjs",
    "generate:check": "node src/generate.mjs --check"
  },
  "dependencies": {
    "@muxui/foundation": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.87.0"
  },
  "devDependencies": {
    "@muxui/catalog": "workspace:*",
    "@muxui/schema": "workspace:*",
    "@muxui/tokens": "workspace:*",
    "@react-native/babel-preset": "0.87.0",
    "@types/react": "19.2.18",
    "babel-jest": "30.4.1",
    "jest": "30.4.2",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-test-renderer": "19.2.8",
    "typescript": "7.0.2"
  }
}
