{
  "name": "@muxui/schema",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./schemas/*": "./schemas/*",
    "./types": "./generated/types.d.ts"
  },
  "scripts": {
    "prepack": "pnpm generate",
    "check": "node src/generate.mjs --check && node --test test/*.test.mjs",
    "generate": "node src/generate.mjs",
    "generate:check": "node src/generate.mjs --check"
  }
}
