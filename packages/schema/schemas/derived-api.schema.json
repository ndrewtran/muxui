{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/derived-api.schema.json",
  "title": "Mux UI derived binding API",
  "description": "A binding's API block derived from its renderer's source (Decision 0031): machine-written by the renderer's generator beside that source, never authored, and merged into the binding by the catalog compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedFrom", "component", "binding", "export", "api"],
  "properties": {
    "schema": { "const": "muxui-derived-api-v1" },
    "generatedFrom": { "type": "string", "pattern": "^packages/react/src/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.ts$" },
    "component": { "type": "string", "pattern": "^muxui:component:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "binding": { "const": "web.react" },
    "export": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "api": { "$ref": "#/$defs/api" }
  },
  "$defs": {
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["props", "events", "defaults", "propDetails", "eventDetails", "types"],
      "properties": {
        "props": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "events": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "defaults": { "type": "object", "additionalProperties": true },
        "propDetails": { "type": "object", "additionalProperties": { "$ref": "#/$defs/propDetail" } },
        "eventDetails": { "type": "object", "additionalProperties": { "$ref": "#/$defs/eventDetail" } },
        "types": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/namedType" }
        }
      }
    },
    "description": { "type": "string", "minLength": 1 },
    "propDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "$ref": "#/$defs/type" },
        "required": { "type": "boolean" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "eventDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prop", "type", "required"],
      "properties": {
        "prop": { "type": "string", "pattern": "^on[A-Z][A-Za-z0-9]*$" },
        "type": { "$ref": "#/$defs/functionType" },
        "required": { "type": "boolean" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "namedType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/type" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "type": {
      "oneOf": [
        { "$ref": "#/$defs/keywordType" },
        { "$ref": "#/$defs/literalType" },
        { "$ref": "#/$defs/unionType" },
        { "$ref": "#/$defs/arrayType" },
        { "$ref": "#/$defs/functionType" },
        { "$ref": "#/$defs/objectType" },
        { "$ref": "#/$defs/recordType" },
        { "$ref": "#/$defs/referenceType" },
        { "$ref": "#/$defs/hostType" }
      ]
    },
    "keywordType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "never appears only as an optional object member's type: a member that must be absent.",
      "properties": { "kind": { "enum": ["string", "number", "boolean", "void", "null", "undefined", "never"] } }
    },
    "literalType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "literal" },
        "value": { "type": ["string", "number", "boolean"] }
      }
    },
    "unionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "members"],
      "properties": {
        "kind": { "const": "union" },
        "members": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/type" } }
      }
    },
    "arrayType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element", "readonly"],
      "properties": {
        "kind": { "const": "array" },
        "element": { "$ref": "#/$defs/type" },
        "readonly": { "type": "boolean" }
      }
    },
    "functionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parameters", "returns"],
      "properties": {
        "kind": { "const": "function" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "required"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "$ref": "#/$defs/type" },
              "required": { "type": "boolean" }
            }
          }
        },
        "returns": { "$ref": "#/$defs/type" }
      }
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "members"],
      "properties": {
        "kind": { "const": "object" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "required", "readonly"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "$ref": "#/$defs/type" },
              "required": { "type": "boolean" },
              "readonly": { "type": "boolean" },
              "description": { "$ref": "#/$defs/description" }
            }
          }
        }
      }
    },
    "recordType": {
      "description": "An object type whose one member is a string index signature: caller-chosen string keys, each holding value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "readonly"],
      "properties": {
        "kind": { "const": "record" },
        "value": { "$ref": "#/$defs/type" },
        "readonly": { "type": "boolean" }
      }
    },
    "referenceType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "reference" },
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
      }
    },
    "hostType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "host" },
        "name": { "type": "string", "pattern": "^(?:React\\.)?[A-Z][A-Za-z0-9]*$" }
      }
    }
  }
}
