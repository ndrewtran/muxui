{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/derived-api.schema.json",
  "title": "Mux UI derived binding API",
  "description": "A binding's API block derived from its renderer's source (Decision 0031): machine-written by the renderer's generator beside that source, never authored, and merged into the binding by the catalog compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedFrom", "component", "binding", "export", "api"],
  "properties": {
    "schema": { "const": "muxui-derived-api-v1" },
    "generatedFrom": { "type": "string", "pattern": "^packages/react/src/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.ts$" },
    "component": { "type": "string", "pattern": "^muxui:component:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "binding": { "const": "web.react" },
    "export": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "api": { "$ref": "#/$defs/api" }
  },
  "$defs": {
    "api": {
      "description": "The API of the binding's root part. A compound whose other parts own Mux UI props lists each one in partApis.",
      "type": "object",
      "additionalProperties": false,
      "required": ["props", "events", "defaults", "propDetails", "eventDetails", "types"],
      "properties": {
        "props": { "$ref": "#/$defs/propList" },
        "events": { "$ref": "#/$defs/eventList" },
        "defaults": { "$ref": "#/$defs/defaultsMap" },
        "propDetails": { "$ref": "#/$defs/propDetailMap" },
        "eventDetails": { "$ref": "#/$defs/eventDetailMap" },
        "types": { "$ref": "#/$defs/typeMap" },
        "partApis": {
          "description": "The API of each non-root part that owns Mux UI props, keyed by its anatomy part. A part without Mux UI-owned props has no entry.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/partApi" }
        }
      }
    },
    "partApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member", "props", "events", "defaults", "propDetails", "eventDetails", "types"],
      "properties": {
        "member": { "description": "The export member that renders the part, such as Item for ListBox.Item.", "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "props": { "$ref": "#/$defs/propList" },
        "events": { "$ref": "#/$defs/eventList" },
        "defaults": { "$ref": "#/$defs/defaultsMap" },
        "propDetails": { "$ref": "#/$defs/propDetailMap" },
        "eventDetails": { "$ref": "#/$defs/eventDetailMap" },
        "types": { "$ref": "#/$defs/typeMap" }
      }
    },
    "propList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "eventList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
    "defaultsMap": { "type": "object", "additionalProperties": true },
    "propDetailMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/propDetail" } },
    "eventDetailMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/eventDetail" } },
    "typeMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/namedType" }
    },
    "description": { "type": "string", "minLength": 1 },
    "propDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "$ref": "#/$defs/type" },
        "required": { "type": "boolean" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "eventDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prop", "type", "required"],
      "properties": {
        "prop": { "type": "string", "pattern": "^on[A-Z][A-Za-z0-9]*$" },
        "type": { "$ref": "#/$defs/functionType" },
        "required": { "type": "boolean" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "namedType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/type" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "type": {
      "oneOf": [
        { "$ref": "#/$defs/keywordType" },
        { "$ref": "#/$defs/literalType" },
        { "$ref": "#/$defs/unionType" },
        { "$ref": "#/$defs/arrayType" },
        { "$ref": "#/$defs/tupleType" },
        { "$ref": "#/$defs/functionType" },
        { "$ref": "#/$defs/objectType" },
        { "$ref": "#/$defs/recordType" },
        { "$ref": "#/$defs/referenceType" },
        { "$ref": "#/$defs/hostType" },
        { "$ref": "#/$defs/unknownType" }
      ]
    },
    "keywordType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "never appears only as an optional object member's type: a member that must be absent.",
      "properties": { "kind": { "enum": ["string", "number", "boolean", "void", "null", "undefined", "never"] } }
    },
    "literalType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "literal" },
        "value": { "type": ["string", "number", "boolean"] }
      }
    },
    "unionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "members"],
      "properties": {
        "kind": { "const": "union" },
        "members": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/type" } }
      }
    },
    "arrayType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element", "readonly"],
      "properties": {
        "kind": { "const": "array" },
        "element": { "$ref": "#/$defs/type" },
        "readonly": { "type": "boolean" }
      }
    },
    "tupleType": {
      "description": "A tuple: a non-empty prefix of required elements, then at most one terminal rest array. rest is the element type of that array, so [A, ...B[]] is elements [A] and rest B.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "elements"],
      "properties": {
        "kind": { "const": "tuple" },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/type" } },
        "rest": { "$ref": "#/$defs/type" }
      }
    },
    "functionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parameters", "returns"],
      "properties": {
        "kind": { "const": "function" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "required"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "$ref": "#/$defs/type" },
              "required": { "type": "boolean" }
            }
          }
        },
        "returns": { "$ref": "#/$defs/type" }
      }
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "members"],
      "properties": {
        "kind": { "const": "object" },
        "additional": {
          "description": "Present on an open item: besides its members, the object takes other string-keyed fields of unknown type (a mutable [key: string]: unknown beside named properties). It marks the object; it is no type, and its members are properties only.",
          "const": "unknown"
        },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/objectMember" }
        }
      },
      "anyOf": [
        { "description": "An ordinary object.", "not": { "required": ["additional"] } },
        {
          "description": "An open item carries no method: a method beside the index signature is not in the grammar.",
          "required": ["additional", "members"],
          "properties": { "members": { "items": { "not": { "required": ["method"] } } } }
        }
      ]
    },
    "objectMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "readonly"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/type" },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "method": {
          "description": "Present on a method signature, whose type is the function it declares: the declaration keeps method syntax, which a function property does not (a method's parameters are bivariant). Only a nested member can be one; a prop, an event, and a named type are never methods.",
          "const": true
        },
        "description": { "$ref": "#/$defs/description" }
      },
      "anyOf": [
        { "description": "A property.", "not": { "required": ["method"] } },
        {
          "description": "A method: required, not readonly, and function-valued.",
          "required": ["method"],
          "properties": {
            "required": { "const": true },
            "readonly": { "const": false },
            "type": { "$ref": "#/$defs/functionType" }
          }
        }
      ]
    },
    "recordType": {
      "description": "An object type whose one member is a string index signature: caller-chosen string keys, each holding value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "readonly"],
      "properties": {
        "kind": { "const": "record" },
        "value": { "$ref": "#/$defs/type" },
        "readonly": { "type": "boolean" }
      }
    },
    "referenceType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "reference" },
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
      }
    },
    "unknownType": {
      "description": "unknown, in one place only: the sole type argument of a Promise host that a function returns, directly or as a member of its return union (a callback that may return a promise whose value is never read). derived-api.mjs checks the place, which this grammar cannot state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "unknown" } }
    },
    "hostType": {
      "description": "An exact host type, or an exact application of a host generic with its type arguments in order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "host" },
        "name": { "type": "string", "pattern": "^(?:React\\.)?[A-Z][A-Za-z0-9]*$" },
        "typeArguments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/type" } }
      }
    }
  }
}
