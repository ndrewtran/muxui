{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/token-section-page-budget-profile.schema.json",
  "title": "Mux UI token section page budget profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "queryApiVersion",
    "lexerVersion",
    "canonicalEntryOrder",
    "entryCostRule",
    "densePageBudgetTokens",
    "normalizedWorstCaseEnvelopeSha256",
    "measuredWorstCaseEnvelopeTokens",
    "envelopeReserveTokens",
    "maximumEntryTokens",
    "defaultItemLimit",
    "maximumItemLimit",
    "minimumProgressEntries",
    "selection",
    "oversizeCode",
    "cursorProfile",
    "cursorPayloadCanonicalization",
    "cursorEncoding",
    "cursorMaximumBytes",
    "cursorBindings",
    "truncation",
    "artifactIdMaximumBytes",
    "artifactIdMaximumLexemes",
    "cursorPositionMaximum",
    "catalogVersionMaximumBytes",
    "catalogVersionMaximumLexemes",
    "envelopeOversizeCode"
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "properties": {
    "schema": { "const": "muxui-token-section-page-budget-profile-v1" },
    "id": { "type": "string", "pattern": "^muxui-token-section-page-budget-2-0-0$" },
    "queryApiVersion": { "enum": ["2.0.0"] },
    "lexerVersion": { "const": "muxui-lexeme-v1" },
    "canonicalEntryOrder": { "const": "tokens by Core token ID; source-crosswalk by source ordinal; bytewise ascending UTF-8 for ties" },
    "entryCostRule": { "const": "Core lexer lexeme count over canonical compact JSON for each complete entry" },
    "densePageBudgetTokens": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "normalizedWorstCaseEnvelopeSha256": { "$ref": "#/$defs/digest" },
    "measuredWorstCaseEnvelopeTokens": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "envelopeReserveTokens": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "maximumEntryTokens": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "defaultItemLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "maximumItemLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "minimumProgressEntries": { "const": 1 },
    "selection": { "const": "greatest non-empty canonical-entry prefix within both the item ceiling and remaining token budget" },
    "oversizeCode": { "const": "MUXUI_QUERY_PAGE_ENTRY_TOO_LARGE" },
    "cursorProfile": { "const": "muxui-section-cursor-v1" },
    "cursorPayloadCanonicalization": { "const": "Core canonical JSON UTF-8" },
    "cursorEncoding": { "const": "c1.<unpadded-base64url-canonical-payload>.<lowercase-sha256-of-canonical-payload>" },
    "cursorMaximumBytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "cursorBindings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["queryApiVersion", "catalogDigest", "tokenSourceContentRevision", "section", "selectorDigest", "nextPosition"] }
    },
    "truncation": { "const": "forbidden" },
    "artifactIdMaximumBytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "artifactIdMaximumLexemes": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "cursorPositionMaximum": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "catalogVersionMaximumBytes": { "type": "integer", "minimum": 5, "maximum": 4096 },
    "catalogVersionMaximumLexemes": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "envelopeOversizeCode": { "const": "MUXUI_QUERY_PAGE_ENVELOPE_TOO_LARGE" }
  }
}
