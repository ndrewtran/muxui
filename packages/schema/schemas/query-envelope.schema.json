{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/query-envelope.schema.json",
  "title": "Mux UI query envelope",
  "x-muxui-response-types": [
    "catalog.manifest",
    "artifact.list",
    "artifact.search",
    "artifact.detail",
    "artifact.detail.section-page",
    "error"
  ],
  "x-muxui-selectors": {
    "platform": ["web.html", "web.react", "native.react-native", "native.react-native-web"],
    "detail": ["brief", "compact", "full"],
    "section": ["api", "examples", "guidance", "decision-context", "accessibility", "styling", "source", "tokens", "source-crosswalk"],
    "purpose": ["generation", "explanation", "validation", "migration"]
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "revisionSet": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "conceptContent": { "$ref": "#/$defs/digest" },
        "bindingContent": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "bindingSpec": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "detailRevisionSet": {
      "allOf": [
        { "$ref": "#/$defs/revisionSet" },
        { "type": "object", "required": ["conceptContent", "bindingContent", "bindingSpec"] }
      ]
    },
    "detailResolution": {
      "allOf": [
        { "$ref": "#/$defs/resolution" },
        {
          "type": "object",
          "properties": {
            "revisions": { "$ref": "#/$defs/detailRevisionSet" }
          }
        }
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["authority", "compatibility", "catalogSource", "sourceRevision", "revisions", "targetPackages"],
      "properties": {
        "authority": { "enum": ["installed-local", "advisory"] },
        "compatibility": { "enum": ["exact", "unresolved"] },
        "catalogSource": { "enum": ["package", "project", "cache", "hosted"] },
        "sourceRevision": { "$ref": "#/$defs/digest" },
        "revisions": { "$ref": "#/$defs/revisionSet" },
        "targetPackages": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "responseMeta": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "authority",
        "revisions",
        "muxuiVersion",
        "catalogVersion",
        "catalogDigest",
        "sourceRevision",
        "resolution",
        "platform",
        "detail",
        "truncated",
        "nextCursor"
      ],
      "properties": {
        "schemaVersion": { "enum": ["2.0.0"] },
        "authority": { "enum": ["installed-local", "advisory"] },
        "revisions": { "$ref": "#/$defs/revisionSet" },
        "muxuiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "catalogDigest": { "$ref": "#/$defs/digest" },
        "sourceRevision": { "$ref": "#/$defs/digest" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "platform": { "enum": [null, "web.html", "web.react", "native.react-native", "native.react-native-web"] },
        "detail": { "enum": ["brief", "compact", "full"] },
        "truncated": { "type": "boolean" },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "detailMeta": {
      "allOf": [
        { "$ref": "#/$defs/responseMeta" },
        {
          "type": "object",
          "properties": {
            "revisions": { "$ref": "#/$defs/detailRevisionSet" },
            "resolution": { "$ref": "#/$defs/detailResolution" }
          }
        }
      ]
    },
    "sourcePointer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["record"],
      "properties": {
        "record": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "name", "summary", "lifecycle", "platforms", "source"],
      "properties": {
        "id": { "$ref": "artifact-ref.schema.json" },
        "kind": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["experimental", "stable", "deprecated", "removed"] },
        "platforms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "source": { "$ref": "#/$defs/sourcePointer" },
        "contentRevision": { "$ref": "#/$defs/digest" }
      }
    },
    "matchReason": {
      "type": "object",
      "additionalProperties": true,
      "required": ["queryTerm", "field", "value", "match", "points"],
      "properties": {
        "queryTerm": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "match": { "enum": ["exact", "prefix"] },
        "points": { "type": "integer", "minimum": 1 }
      }
    },
    "searchResult": {
      "allOf": [
        { "$ref": "#/$defs/artifactSummary" },
        {
          "type": "object",
          "required": ["score", "matchReasons"],
          "properties": {
            "score": { "type": "integer", "minimum": 1 },
            "matchReasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matchReason" } }
          }
        }
      ]
    },
    "operationDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "requestKeys", "responseType"],
      "properties": {
        "available": { "type": "boolean" },
        "requestKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "responseType": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "operationManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["getManifest", "listArtifacts", "searchArtifacts", "getArtifact", "planComposition"],
      "properties": {
        "getManifest": { "$ref": "#/$defs/operationDescriptor" },
        "listArtifacts": { "$ref": "#/$defs/operationDescriptor" },
        "searchArtifacts": { "$ref": "#/$defs/operationDescriptor" },
        "getArtifact": { "$ref": "#/$defs/operationDescriptor" },
        "planComposition": { "$ref": "#/$defs/operationDescriptor" }
      }
    },
    "cliIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "const": "muxui" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "cliCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "effect", "requiresConfirmation"],
      "properties": {
        "available": { "type": "boolean" },
        "effect": { "enum": ["read-only", "project-write", "external-write"] },
        "requiresConfirmation": { "type": "boolean" }
      }
    },
    "cliUnavailableCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "const": false }
      }
    },
    "cliArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "requestKey": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "type": { "enum": ["artifact-kind", "string"] }
      }
    },
    "cliOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "flag", "type", "default"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "flag": { "type": "string", "pattern": "^--[a-z][a-z-]*$" },
        "requestKey": { "type": "string", "minLength": 1 },
        "type": { "enum": ["boolean", "integer", "string"] },
        "default": {},
        "choices": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "conflicts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "cliTokenBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "compact", "full"],
      "properties": {
        "brief": { "type": "integer", "minimum": 1 },
        "compact": { "type": "integer", "minimum": 1 },
        "full": { "type": "integer", "minimum": 1 }
      }
    },
    "cliUnavailableCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "earliestMilestone", "capability"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "earliestMilestone": { "type": "string", "pattern": "^G[0-9]+\\.[0-9]+$" },
        "capability": { "$ref": "#/$defs/cliUnavailableCapability" }
      }
    },
    "cliCompactCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "responseType", "responseSchema", "tokenBudgets"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "responseType": { "type": "string", "minLength": 1 },
        "responseSchema": { "type": "string", "minLength": 1 },
        "tokenBudgets": { "$ref": "#/$defs/cliTokenBudgets" }
      }
    },
    "cliFullCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "summary", "operation", "arguments", "options", "examples",
        "budgetFixture", "tokenBudgets", "responseType", "responseSchema", "capability"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "$ref": "#/$defs/cliArgument" } },
        "options": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "examples": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "budgetFixture": { "type": "object" },
        "tokenBudgets": { "$ref": "#/$defs/cliTokenBudgets" },
        "responseType": { "type": "string", "minLength": 1 },
        "responseSchema": { "type": "string", "minLength": 1 },
        "capability": { "$ref": "#/$defs/cliCapability" }
      }
    },
    "cliBriefManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commands"],
      "properties": {
        "name": { "const": "muxui" },
        "version": { "type": "string", "minLength": 1 },
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "cliCompactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "commands", "outputModes", "unavailableCommands"],
      "properties": {
        "cli": { "$ref": "#/$defs/cliIdentity" },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cliCompactCommand" } },
        "outputModes": { "type": "array", "items": { "enum": ["human", "json", "dense"] }, "uniqueItems": true },
        "unavailableCommands": { "type": "array", "items": { "$ref": "#/$defs/cliUnavailableCommand" } }
      }
    },
    "cliFullManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "cli", "tokenizer", "selectors", "globalOptions",
        "bareJsonRecoveryCommand", "commands", "unavailableCommands", "outputModes", "surfacePolicy"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "cli": { "$ref": "#/$defs/cliIdentity" },
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "selectors": { "type": "array", "items": { "$ref": "#/$defs/cliOption" } },
        "globalOptions": { "type": "array", "items": { "$ref": "#/$defs/cliOption" } },
        "bareJsonRecoveryCommand": { "type": "string", "minLength": 1 },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cliFullCommand" } },
        "unavailableCommands": { "type": "array", "items": { "$ref": "#/$defs/cliUnavailableCommand" } },
        "outputModes": { "type": "array", "items": { "enum": ["human", "json", "dense"] }, "uniqueItems": true },
        "surfacePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cli", "mcp"],
          "properties": {
            "cli": { "$ref": "#/$defs/cliCapability" },
            "mcp": { "$ref": "#/$defs/cliCapability" }
          }
        }
      }
    },
    "cliManifest": {
      "oneOf": [
        { "$ref": "#/$defs/cliBriefManifest" },
        { "$ref": "#/$defs/cliCompactManifest" },
        { "$ref": "#/$defs/cliFullManifest" }
      ]
    },
    "manifestData": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "formatVersion",
        "catalogVersion",
        "catalogDigest",
        "sourceRevision",
        "operations",
        "responseTypes",
        "selectors",
        "artifactKinds",
        "platforms",
        "capabilities",
        "cli"
      ],
      "properties": {
        "formatVersion": { "const": "1.0.0" },
        "catalogVersion": { "type": "string" },
        "catalogDigest": { "$ref": "#/$defs/digest" },
        "sourceRevision": { "$ref": "#/$defs/digest" },
        "operations": { "$ref": "#/$defs/operationManifest" },
        "responseTypes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "selectors": { "type": "object", "minProperties": 1 },
        "artifactKinds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "platforms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "type": "object" } },
        "cli": { "$ref": "#/$defs/cliManifest" }
      }
    },
    "listData": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/artifactSummary" } }
      }
    },
    "searchData": {
      "type": "object",
      "additionalProperties": true,
      "required": ["query", "items"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/searchResult" } }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "source", "target"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "tokenRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "requirement", "type", "unit", "modes", "overridePolicy"],
      "properties": {
        "token": { "type": "string", "pattern": "^(semantic|component)\\." },
        "requirement": { "enum": ["required", "optional", "deprecated"] },
        "type": { "enum": ["color", "dimension", "duration", "number", "string", "easing", "transition"] },
        "unit": { "enum": ["hex", "px", "ms", "unitless", "string", "structured"] },
        "modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "overridePolicy": { "enum": ["fixed", "theme", "instance"] },
        "fallback": {
          "oneOf": [
            { "$ref": "binding.schema.json#/$defs/fallbackToken" },
            { "$ref": "binding.schema.json#/$defs/fallbackValue" }
          ]
        }
      }
    },
    "tokenClosureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "layer", "type", "unit", "meaning", "overridePolicy", "resolved", "dependencies"],
      "properties": {
        "token": { "type": "string", "pattern": "^(reference|semantic|component)\\." },
        "layer": { "enum": ["reference", "semantic", "component"] },
        "type": { "enum": ["color", "dimension", "duration", "number", "string", "effect", "easing", "transition"] },
        "unit": { "enum": ["hex", "px", "ms", "unitless", "string", "structured"] },
        "meaning": { "type": "string", "minLength": 1 },
        "overridePolicy": { "enum": ["fixed", "theme", "instance"] },
        "resolved": { "type": ["string", "number", "object"] },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(reference|semantic|component)\\." },
          "uniqueItems": true
        }
      }
    },
    "tokenRequirementSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "bindingId", "profile", "source", "sourceRevision", "tokenContractVersion", "requirements", "closure", "digest"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "bindingId": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["web.html", "web.react", "native.ios", "native.android", "native.react-native-web"] },
        "source": { "type": "string", "pattern": "^muxui:token:" },
        "sourceRevision": { "$ref": "#/$defs/digest" },
        "tokenContractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/tokenRequirement" } },
        "closure": { "type": "array", "items": { "$ref": "#/$defs/tokenClosureEntry" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "platformSafetyDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
        "disposition": { "enum": ["required", "not-applicable"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "platformSafetyRequirementSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "contractDigest", "bindingId", "profile", "declarationRevision", "dispositions", "digest"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contractDigest": { "$ref": "#/$defs/digest" },
        "bindingId": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["web.html", "web.react", "ios", "android", "native.react-native-web"] },
        "validationProfile": { "enum": ["native.ios", "native.android", "native.react-native-web"] },
        "declarationRevision": { "$ref": "#/$defs/digest" },
        "dispositions": { "type": "array", "items": { "$ref": "#/$defs/platformSafetyDisposition" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "stylingValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["recipe", "requirementSets", "platformSafetyRequirementSets"],
          "properties": {
            "recipe": { "type": "object" },
            "requirementSets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/tokenRequirementSet" }
            },
            "platformSafetyRequirementSets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/platformSafetyRequirementSet" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["recipes", "requirementSets", "platformSafetyRequirementSets"],
          "properties": {
            "recipes": { "type": "object" },
            "requirementSets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/tokenRequirementSet" }
            },
            "platformSafetyRequirementSets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/platformSafetyRequirementSet" }
            }
          }
        }
      ]
    },
    "detailData": {
      "type": "object",
      "additionalProperties": true,
      "required": ["artifact"],
      "allOf": [{
        "oneOf": [
          {
            "required": ["section", "value"],
            "properties": {
              "section": { "const": "styling" },
              "value": { "$ref": "#/$defs/stylingValue" }
            }
          },
          {
            "required": ["section", "value"],
            "properties": {
              "section": { "enum": ["api", "examples", "guidance", "decision-context", "accessibility", "source"] },
              "value": true
            }
          },
          { "not": { "required": ["section"] } }
        ]
      }],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": true,
          "propertyNames": { "enum": ["accessibility", "anatomy", "availability", "availableOn", "availableSections", "binding", "bindingSpecRevisions", "bindings", "complexity", "contentRevision", "id", "intent", "keywords", "kind", "lifecycle", "name", "platformSafetyRequirementSetDigests", "platformSafetyRequirementSets", "platforms", "policy", "prerequisites", "schemaVersion", "source", "sourceCrosswalkDigest", "states", "summary", "theme", "tokenContractVersion", "tokenCount", "tokenRequirementSetDigests", "tokenRequirementSets", "tokenSourceContentRevision"] },
          "required": ["id", "kind", "source"],
          "properties": {
            "id": { "$ref": "artifact-ref.schema.json" },
            "kind": { "type": "string" },
            "source": { "$ref": "#/$defs/sourcePointer" },
            "tokenRequirementSets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/tokenRequirementSet" }
            },
            "platformSafetyRequirementSets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/platformSafetyRequirementSet" }
            }
          }
        },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "section": { "type": "string" },
        "value": true
      }
    },
    "successBase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["apiVersion", "type", "data", "meta", "warnings"],
      "properties": {
        "apiVersion": { "enum": ["2.0.0"] },
        "type": { "enum": ["catalog.manifest", "artifact.list", "artifact.search", "artifact.detail"] },
        "data": { "type": "object" },
        "meta": { "$ref": "#/$defs/responseMeta" },
        "warnings": { "type": "array", "items": { "$ref": "diagnostic.schema.json" } }
      }
    },
    "manifestResponse": {
      "allOf": [
        { "$ref": "#/$defs/successBase" },
        { "properties": { "type": { "const": "catalog.manifest" }, "data": { "$ref": "#/$defs/manifestData" } } }
      ]
    },
    "listResponse": {
      "allOf": [
        { "$ref": "#/$defs/successBase" },
        { "properties": { "type": { "const": "artifact.list" }, "data": { "$ref": "#/$defs/listData" } } }
      ]
    },
    "searchResponse": {
      "allOf": [
        { "$ref": "#/$defs/successBase" },
        { "properties": { "type": { "const": "artifact.search" }, "data": { "$ref": "#/$defs/searchData" } } }
      ]
    },
    "detailResponse": {
      "allOf": [
        { "$ref": "#/$defs/successBase" },
        {
          "properties": {
            "type": { "const": "artifact.detail" },
            "data": { "$ref": "#/$defs/detailData" },
            "meta": { "$ref": "#/$defs/detailMeta" }
          }
        }
      ]
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": ["apiVersion", "type", "error"],
      "properties": {
        "apiVersion": { "enum": ["2.0.0"] },
        "type": { "const": "error" },
        "error": { "$ref": "diagnostic.schema.json" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/manifestResponse" },
    { "$ref": "#/$defs/listResponse" },
    { "$ref": "#/$defs/searchResponse" },
    { "$ref": "#/$defs/detailResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "section-page.schema.json" }
  ]
}
