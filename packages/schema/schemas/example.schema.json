{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/example.schema.json",
  "title": "Mux UI example",
  "description": "An example binds one component binding or is listed as one pattern variant; validateCatalogRecords (graph validation) requires exactly one owner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "summary", "lifecycle", "complexity", "prerequisites", "source"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^muxui:example:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "kind": { "const": "example" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["experimental", "stable", "deprecated", "removed"] },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "guidanceImpact", "purposes"],
      "properties": {
        "ref": { "type": "string", "pattern": "^muxui:component:[a-z0-9]+(?:-[a-z0-9]+)*#(?:web\\.html|web\\.react|native\\.react-native)$" },
        "guidanceImpact": { "enum": ["normative", "editorial"] },
        "purposes": { "type": "array", "minItems": 1, "items": { "enum": ["generation", "explanation", "validation", "migration"] }, "uniqueItems": true },
        "preference": { "type": "integer", "minimum": 0 },
        "runtimeProfiles": { "type": "array", "items": { "enum": ["ios", "android", "native.react-native-web"] }, "uniqueItems": true }
      }
    },
    "complexity": { "enum": ["minimal", "representative", "advanced", "edge-case"] },
    "prerequisites": { "type": "array", "items": { "$ref": "artifact-ref.schema.json" }, "uniqueItems": true },
    "source": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$" },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^muxui\\.experimental\\.[a-z0-9]+(?:-[a-z0-9]+)*$" }, "additionalProperties": true }
  }
}
