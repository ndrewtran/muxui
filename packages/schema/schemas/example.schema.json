{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/example.schema.json",
  "title": "Mux UI example",
  "description": "An example binds one component binding or is listed as one pattern variant; validateCatalogRecords (graph validation) requires exactly one owner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "summary", "lifecycle", "complexity", "prerequisites", "source"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
    },
    "id": {
      "type": "string",
      "pattern": "^muxui:example:[a-z0-9]+(?:-[a-z0-9]+)*$",
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
    },
    "kind": {
      "const": "example",
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "x-muxui-authoring": { "effect": "editorial", "revisionAxes": ["content", "binding-spec", "pattern-spec"], "autofixes": ["trim-outer-whitespace"] }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "x-muxui-authoring": { "effect": "editorial", "revisionAxes": ["content", "binding-spec", "pattern-spec"], "autofixes": ["trim-outer-whitespace"] }
    },
    "lifecycle": {
      "enum": ["experimental", "stable", "deprecated", "removed"],
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "guidanceImpact", "purposes"],
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] },
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^muxui:component:[a-z0-9]+(?:-[a-z0-9]+)*#(?:web\\.html|web\\.react|native\\.react-native)$",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
        },
        "guidanceImpact": {
          "enum": ["normative", "editorial"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["generation", "explanation", "validation", "migration"] },
          "uniqueItems": true,
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
        },
        "preference": {
          "type": "integer",
          "minimum": 0,
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
        },
        "runtimeProfiles": {
          "type": "array",
          "items": { "enum": ["ios", "android", "native.react-native-web"] },
          "uniqueItems": true,
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
        }
      }
    },
    "complexity": {
      "enum": ["minimal", "representative", "advanced", "edge-case"],
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "artifact-ref.schema.json" },
      "uniqueItems": true,
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
    },
    "source": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$",
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["content", "binding-spec", "pattern-spec"] }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^muxui\\.experimental\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": true,
      "x-muxui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["content", "binding-spec", "pattern-spec"]
      }
    }
  }
}
