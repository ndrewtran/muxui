{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/artifact-ref.schema.json",
  "title": "Mux UI ArtifactRef",
  "description": "The sole canonical declaration of immutable Mux UI artifact identity.",
  "type": "string",
  "pattern": "^muxui:(?:component|pattern|token|foundation|guide|example|pitfall|migration|capability):[a-z0-9]+(?:-[a-z0-9]+)*$",
  "x-muxui-kinds": [
    "component",
    "pattern",
    "token",
    "foundation",
    "guide",
    "example",
    "pitfall",
    "migration",
    "capability"
  ],
  "x-muxui-enabled-record-kinds": [
    "component",
    "pattern",
    "token",
    "guide",
    "example",
    "capability"
  ]
}
