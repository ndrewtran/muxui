{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/binding.schema.json",
  "title": "Mux UI platform binding",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{
    "oneOf": [
      {
      "required": ["schemaVersion", "lifecycle", "strategy", "api", "behavior", "accessibility", "tokenRecipe", "platformSafety", "runtimeProfiles"],
      "properties": { "strategy": {
        "enum": ["direct", "adapted", "native-alternative"],
        "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
      } },
      "not": {
        "anyOf": [
          { "required": ["reason"] },
          { "required": ["alternative"] }
        ]
      }
      },
      {
      "required": ["schemaVersion", "strategy", "reason", "platformSafety"],
      "properties": { "strategy": {
        "const": "unsupported",
        "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
      } },
      "not": {
        "anyOf": [
          { "required": ["lifecycle"] },
          { "required": ["api"] },
          { "required": ["behavior"] },
          { "required": ["accessibility"] },
          { "required": ["tokenRecipe"] },
          { "required": ["runtimeProfiles"] }
        ]
      }
      }
    ]
  }],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content"] }
    },
    "lifecycle": {
      "enum": ["experimental", "stable", "deprecated", "removed"],
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
    },
    "strategy": {
      "enum": ["direct", "adapted", "native-alternative", "unsupported"],
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content"] }
    },
    "alternative": {
      "$ref": "artifact-ref.schema.json",
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content"] }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["props", "events", "parts", "defaults"],
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] },
      "properties": {
        "props": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          }
        },
        "parts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": true,
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        }
      }
    },
    "behavior": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "x-muxui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content", "binding-spec"]
      }
    },
    "accessibility": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
    },
    "tokenRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "requirements"],
      "x-muxui-authoring": {
        "effect": "incompatible",
        "revisionAxes": ["binding-content", "binding-spec"]
      },
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^muxui:token:[a-z0-9]+(?:-[a-z0-9]+)*$",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "items": { "$ref": "#/$defs/tokenRequirement" }
        }
      }
    },
    "platformSafety": {
      "type": "array",
      "minItems": 1,
      "x-muxui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content", "binding-spec"]
      },
      "items": { "$ref": "#/$defs/platformSafetyDeclaration" }
    },
    "runtimeProfiles": {
      "type": "object",
      "additionalProperties": false,
      "x-muxui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content", "binding-spec"]
      },
      "properties": {
        "ios": {
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": {
              "const": "native.ios",
              "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } } }
          ]
        },
        "android": {
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": {
              "const": "native.android",
              "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } } }
          ]
        },
        "native.react-native-web": {
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": {
              "const": "native.react-native-web",
              "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } } }
          ]
        }
      }
    },
    "editorialNotes": {
      "type": "array",
      "items": { "type": "string" },
      "x-muxui-authoring": { "effect": "editorial", "revisionAxes": ["binding-content"], "autofixes": ["trim-outer-whitespace"] }
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "x-muxui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content"]
      }
    }
  },
  "$defs": {
    "platformSafetyDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "requirements"],
      "properties": {
        "profile": {
          "enum": ["web.html", "web.react", "ios", "android", "native.react-native-web"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "validationProfile": {
          "enum": ["native.ios", "native.android", "native.react-native-web"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "x-muxui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "items": { "$ref": "#/$defs/platformSafetyDisposition" }
        }
      }
    },
    "platformSafetyDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "disposition": {
          "enum": ["required", "not-applicable"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        }
      }
    },
    "tokenRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "requirement"],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^(semantic|component)\\.[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "requirement": {
          "enum": ["required", "optional", "deprecated"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["web.html", "web.react", "native.ios", "native.android", "native.react-native-web"] },
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "fallback": {
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] },
          "oneOf": [
            { "$ref": "#/$defs/fallbackToken" },
            { "$ref": "#/$defs/fallbackValue" }
          ]
        }
      }
    },
    "fallbackToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profiles", "evidenceIds", "token"],
      "properties": {
        "kind": {
          "const": "token",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "profiles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["web.html", "web.react", "native.ios", "native.android", "native.react-native-web"] },
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "evidenceIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^E-G[0-9]+\\.[0-9]+-[0-9]{2}$" },
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "token": {
          "type": "string", "pattern": "^(semantic|component)\\.[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        }
      }
    },
    "fallbackValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profiles", "evidenceIds", "type", "unit", "value"],
      "properties": {
        "kind": {
          "const": "value",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "profiles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["web.html", "web.react", "native.ios", "native.android", "native.react-native-web"] },
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "evidenceIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^E-G[0-9]+\\.[0-9]+-[0-9]{2}$" },
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "type": {
          "enum": ["color", "dimension", "duration", "number", "string", "easing", "transition"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "unit": {
          "enum": ["hex", "px", "ms", "unitless", "string", "structured"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "value": {
          "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "object" }],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "oneOf": [
          {
            "required": ["strategy", "lifecycle", "validationProfile"],
            "properties": { "strategy": {
              "enum": ["direct", "adapted", "native-alternative"],
              "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } },
            "not": {
              "anyOf": [
                { "required": ["reason"] },
                { "required": ["alternative"] }
              ]
            }
          },
          {
            "required": ["strategy", "reason"],
            "properties": { "strategy": {
              "const": "unsupported",
              "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } },
            "not": {
              "anyOf": [
                { "required": ["lifecycle"] },
                { "required": ["validationProfile"] }
              ]
            }
          }
        ]
      }],
      "properties": {
        "strategy": {
          "enum": ["direct", "adapted", "native-alternative", "unsupported"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "lifecycle": {
          "enum": ["experimental", "stable", "deprecated", "removed"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "validationProfile": {
          "enum": ["native.ios", "native.android", "native.react-native-web"],
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "alternative": {
          "$ref": "artifact-ref.schema.json",
          "x-muxui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^muxui\\.experimental\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": true
    }
  }
}
