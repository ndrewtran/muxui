{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxui.dev/schema/diagnostic.schema.json",
  "title": "Mux UI diagnostic",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "secondaryFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "ruleId", "reason"],
      "properties": {
        "code": {
          "enum": [
            "MUXUI_CATALOG_NOT_DECLARED",
            "MUXUI_CATALOG_NOT_INSTALLED",
            "MUXUI_CATALOG_DECLARATION_DRIFT",
            "MUXUI_CATALOG_INTEGRITY_MISMATCH",
            "MUXUI_CATALOG_RESOLUTION_AMBIGUOUS",
            "MUXUI_QUERY_API_VERSION_UNSUPPORTED",
            "MUXUI_CATALOG_INCOMPATIBLE"
          ]
        },
        "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "version", "catalogDigest", "rejectionReasons"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "catalogDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "rejectionReasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "compatibilityFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "required", "actual"],
      "properties": {
        "dimension": {
          "enum": ["schema", "tooling-api", "query-api", "binding-spec", "renderer-package", "export", "token", "platform-safety", "release-manifest"]
        },
        "required": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 }
      }
    },
    "resolverDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspacePath", "packageManager", "secondaryFailures"],
      "properties": {
        "workspacePackage": { "type": ["string", "null"] },
        "workspacePath": { "type": "string", "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+)$" },
        "packageManager": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "declaredRange": { "type": ["string", "null"] },
        "lockfileVersions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "installedVersions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "catalogVersion": { "type": ["string", "null"] },
        "catalogDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "expectedDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "actualDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "compatibilityFailures": { "type": "array", "items": { "$ref": "#/$defs/compatibilityFailure" } },
        "secondaryFailures": { "type": "array", "items": { "$ref": "#/$defs/secondaryFailure" }, "uniqueItems": true }
      }
    }
  },
  "required": ["code", "ruleId", "message", "retryable", "details"],
  "properties": {
    "code": { "$ref": "error-code.schema.json" },
    "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "message": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "details": { "type": "object", "additionalProperties": true },
    "nextCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": ["command", "effect", "requiresConfirmation"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["read-only", "project-write", "dependency-install"] },
        "requiresConfirmation": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "code": {
          "enum": [
            "MUXUI_SCHEMA_INVALID",
            "MUXUI_ARTIFACT_ID_INVALID",
            "MUXUI_RELATION_INVALID",
            "MUXUI_FIELD_OWNERSHIP_INVALID",
            "MUXUI_SCHEMA_VERSION_UNSUPPORTED",
            "MUXUI_QUERY_INVALID",
            "MUXUI_QUERY_API_VERSION_UNSUPPORTED",
            "MUXUI_QUERY_PAGE_ENVELOPE_TOO_LARGE",
            "MUXUI_QUERY_PAGE_ENTRY_TOO_LARGE",
            "MUXUI_CURSOR_INVALID",
            "MUXUI_ARTIFACT_NOT_FOUND"
          ]
        }
      }
    },
    {
      "properties": {
        "code": { "const": "MUXUI_PROJECT_NOT_FOUND" },
        "details": { "$ref": "#/$defs/resolverDetails" }
      }
    },
    {
      "properties": {
        "code": { "const": "MUXUI_CATALOG_NOT_DECLARED" },
        "details": { "$ref": "#/$defs/resolverDetails" }
      }
    },
    {
      "properties": {
        "code": { "const": "MUXUI_CATALOG_NOT_INSTALLED" },
        "details": { "$ref": "#/$defs/resolverDetails" }
      }
    },
    {
      "properties": {
        "code": { "const": "MUXUI_CATALOG_DECLARATION_DRIFT" },
        "details": { "$ref": "#/$defs/resolverDetails" }
      }
    },
    {
      "properties": {
        "code": { "const": "MUXUI_CATALOG_INTEGRITY_MISMATCH" },
        "details": { "$ref": "#/$defs/resolverDetails" }
      }
    },
    {
      "properties": {
        "code": { "const": "MUXUI_CATALOG_RESOLUTION_AMBIGUOUS" },
        "details": { "$ref": "#/$defs/resolverDetails" }
      }
    },
    {
      "properties": {
        "code": { "const": "MUXUI_CATALOG_INCOMPATIBLE" },
        "details": { "$ref": "#/$defs/resolverDetails" }
      }
    }
  ]
}
