    "MUXUI_PROJECT_NOT_FOUND",
    "MUXUI_CATALOG_NOT_DECLARED",
    "MUXUI_CATALOG_NOT_INSTALLED",
    "MUXUI_CATALOG_DECLARATION_DRIFT",
