{
  "name": "@muxui/catalog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./compiler": "./src/compiler.mjs",
    "./bundle": "./generated/catalog.mjs",
    "./catalog.json": "./generated/catalog.json",
    "./catalog-package.json": "./generated/catalog-package.json",
    "./token-section-page-budget-profile.json": "./token-section-page-budget-profile.json"
  },
  "muxUi": {
    "catalogPackage": "./generated/catalog-package.json"
  },
  "scripts": {
    "prepack": "pnpm --filter @muxui/catalog... generate",
    "check": "node src/generate.mjs --check && node --test test/*.test.mjs",
    "generate": "node src/generate.mjs",
    "generate:check": "node src/generate.mjs --check"
  },
  "dependencies": {
    "@muxui/schema": "workspace:*",
    "@muxui/tokens": "workspace:*"
  }
}
