{
  "name": "@muxui/docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @muxui/docs^... generate && astro dev",
    "start": "pnpm dev",
    "build": "pnpm --filter @muxui/docs^... generate && astro build",
    "check:docs": "pnpm --filter @muxui/docs^... generate && node scripts/check-docs.mjs",
    "check:docs:rendered": "node scripts/check-rendered-source.mjs",
    "preview": "astro preview",
    "astro": "pnpm --filter @muxui/docs^... generate && astro",
    "check": "pnpm --filter @muxui/docs^... generate && node scripts/check.mjs"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@astrojs/starlight": "0.42.0",
    "@muxui/catalog": "workspace:*",
    "@muxui/react": "workspace:*",
    "astro": "7.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@muxui/tooling": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "typescript": "6.0.3"
  }
}
