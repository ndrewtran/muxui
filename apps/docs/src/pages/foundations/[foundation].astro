---
import FoundationExplorer from '../../components/FoundationExplorer.tsx';
import FoundationPage from '../../components/FoundationPage.astro';
import GuideProjection from '../../components/GuideProjection.astro';
import { FOUNDATION_DATA, FOUNDATION_PAGES, foundationPage } from '../../lib/foundations.ts';
import { getGuide } from '../../lib/catalog.ts';

export function getStaticPaths() {
	// The overview card copy is not needed by the page, and leaving it out keeps the island props small.
	return FOUNDATION_PAGES.map(({ card: _card, ...page }) => ({ params: { foundation: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ReturnType<typeof foundationPage> };
if (!page || page.kind === 'overview') throw new Error('Unknown foundation page.');
const guide = getGuide(`muxui:guide:foundations-${page.slug}`);
---

<FoundationPage title={page.title} description={page.description}>
	<FoundationExplorer page={page} data={FOUNDATION_DATA} client:load />
	{guide ? (
		<GuideProjection id={guide.id} />
	) : (
		null
	)}
</FoundationPage>
