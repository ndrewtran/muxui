---
import FoundationExplorer from '../../components/FoundationExplorer.tsx';
import FoundationPage from '../../components/FoundationPage.astro';
import GuideProjection from '../../components/GuideProjection.astro';
import { FOUNDATION_DATA, FOUNDATION_OVERVIEW } from '../../lib/foundations.ts';
import { getGuide } from '../../lib/catalog.ts';

const guide = getGuide('muxui:guide:foundations');
---

<FoundationPage title={FOUNDATION_OVERVIEW.title} description={FOUNDATION_OVERVIEW.description}>
	<FoundationExplorer page={FOUNDATION_OVERVIEW} data={FOUNDATION_DATA} client:load />
	{guide ? (
		<GuideProjection id={guide.id} />
	) : (
		null
	)}
</FoundationPage>
