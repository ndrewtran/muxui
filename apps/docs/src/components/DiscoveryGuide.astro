---
import { createRequire } from 'node:module';
import { resolve } from 'node:path';

const repositoryRoot = resolve(import.meta.dirname, '../../../../../');
const surfaceModule: unknown = createRequire(import.meta.url)(
	resolve(repositoryRoot, 'packages/tooling/generated/command-surface.mjs'),
);

interface CliCommand {
	name: string;
	summary: string;
	examples: readonly string[];
}

function isRecord(value: unknown): value is Record<string, unknown> {
	return typeof value === 'object' && value !== null && !Array.isArray(value);
}

function requiredString(value: unknown, field: string): string {
	if (typeof value !== 'string' || value.length === 0) {
		throw new Error(`The generated CLI surface is missing ${field}.`);
	}
	return value;
}

function readCommands(value: unknown): readonly CliCommand[] {
	if (!isRecord(value) || !isRecord(value.cliManifest) || !Array.isArray(value.cliManifest.commands)) {
		throw new Error('The generated CLI surface is missing its canonical command manifest.');
	}

	return value.cliManifest.commands.map((command, index) => {
		if (!isRecord(command) || !Array.isArray(command.examples) || command.examples.some((example) => typeof example !== 'string')) {
			throw new Error(`The generated CLI surface has an invalid command at index ${index}.`);
		}
		return Object.freeze({
			name: requiredString(command.name, `command[${index}].name`),
			summary: requiredString(command.summary, `command[${index}].summary`),
			examples: Object.freeze([...command.examples]),
		});
	});
}

const commands = readCommands(surfaceModule);
---

<p>Mux UI’s catalog is the source for component discovery, API retrieval, and example selection. The CLI surface below is projected from the generated command registry so its grammar and examples stay aligned with the canonical owner.</p>

<div class="cli-command-list">
	{commands.map((command) => (
		<section class="cli-command" id={`command-${command.name}`}>
			<h2>{command.name}</h2>
			<p>{command.summary}</p>
			<pre><code>{command.examples.join('\n')}</code></pre>
		</section>
	))}
</div>

<h2 id="current-availability">Current availability</h2>

<p>The catalog query baseline is experimental and read-only. Composition planning, consumer-project mutation, and hosted latest guidance are outside the current product boundary.</p>
