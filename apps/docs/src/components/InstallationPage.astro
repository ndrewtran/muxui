---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import InstallationGuide from './InstallationGuide.astro';

const headings = [
	{ depth: 2, text: 'Install', slug: 'install' },
	{ depth: 2, text: 'Usage', slug: 'usage' },
	{ depth: 2, text: 'Local tarball', slug: 'local-tarball' },
];
---

<StarlightPage
	frontmatter={{
		title: 'Installation',
		description: 'Install the Mux UI React prerelease.',
	}}
	headings={headings}
>
	<InstallationGuide />
</StarlightPage>
