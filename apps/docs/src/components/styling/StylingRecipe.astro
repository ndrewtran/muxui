---
import type { FamilyStyling } from '../../../../../packages/react/test/support/styling-reference.mjs';
import previewHeights from '../../lib/preview-heights.json';
import CodeBlock from '../CodeBlock.astro';
import ExampleHost from '../ExampleHost.tsx';

interface Props {
	name: string;
	slug: string;
	styling: Pick<FamilyStyling, 'hooks' | 'tokens' | 'recipe'>;
	/** The Basic example's source path: both previews run this example. */
	source: string;
}

const { name, slug, styling, source } = Astro.props;
const { hooks, tokens, recipe } = styling;

// What this block may say about the recipe it prints is checked here, at build, against the rows the same page prints: a recipe that
// names a hook, an attribute or a role that the tables above do not list, or a token that is not a theme role some rule reads, fails
// the build instead of printing a claim the page cannot back.
const rows = hooks.groups.flatMap(({ rows: list }) => list);
const hookClasses = new Set(rows.flatMap(({ hook }) => hook === null ? [] : [...hook.matchAll(/\.(muxui-[\w-]+)/gu)].map(([, className]) => className)));
const hookAttributes = new Set(rows.flatMap(({ hook }) => hook !== null && hook.startsWith('data-muxui-') ? [hook] : []));
const roles = new Map(tokens.groups.flatMap(({ rows: list }) => list).map((row) => [row.cssVar, row]));
const classNames = new Set<string>();
const attributes = new Set<string>();
const variables = new Set<string>();
for (const step of recipe.steps) {
	for (const [, className] of step.selector.matchAll(/\.(muxui-[\w-]+)/gu)) classNames.add(className);
	for (const [, attribute] of step.selector.matchAll(/\[(data-muxui-[\w-]+)/gu)) attributes.add(attribute);
	if (step.kind === 'token') variables.add(step.declaration.slice(0, step.declaration.indexOf(':')));
}
for (const className of classNames) if (!hookClasses.has(className)) throw new Error(`The ${name} recipe names .${className}, which its Hooks table does not list.`);
for (const attribute of attributes) if (!hookAttributes.has(attribute)) throw new Error(`The ${name} recipe names ${attribute}, which its Hooks table does not list.`);
for (const variable of variables) {
	const role = roles.get(variable);
	if (role === undefined || role.policy !== 'theme' || role.readBy?.kind !== 'rules') throw new Error(`The ${name} recipe assigns ${variable}, which is not a theme role that a rule reads.`);
}
const hasRules = recipe.steps.some(({ kind }) => kind !== 'token');
if (hasRules && !recipe.rules.includes('@layer muxui.utilities {')) throw new Error(`The ${name} recipe has part or state rules outside muxui.utilities.`);
if (recipe.css.includes('!important')) throw new Error(`The ${name} recipe uses !important.`);
const kinds = [
	{ list: classNames, one: 'class', many: 'classes' },
	{ list: attributes, one: 'attribute', many: 'attributes' },
	{ list: variables, one: 'token', many: 'tokens' },
];
// The height each preview reserves before its example renders, so the page below does not move when it does (src/lib/preview-heights.json,
// recorded from the rendered examples by apps/scale/test/browser/record-preview-heights.mjs; the docs check holds it to the families that have previews).
const reserved = (previewHeights as Record<string, { narrow: number; wide: number }>)[slug] ?? { narrow: 0, wide: 0 };
const hasPreview = recipe.preview && Object.hasOwn(previewHeights, slug);
const names = classNames.size + attributes.size + variables.size;
// The opening sentence counts the changes the recipe makes and names their kinds, so a family with four or five says so.
const stepKinds = [
	{ kind: 'token', one: 'a theme role', many: 'theme roles' },
	{ kind: 'part', one: 'a part rule', many: 'part rules' },
	{ kind: 'state', one: 'a state rule', many: 'state rules' },
].flatMap(({ kind, one, many }) => {
	const total = recipe.steps.filter((step) => step.kind === kind).length;
	return total === 0 ? [] : [total === 1 ? one : `${total} ${many}`];
});
const opening = `${recipe.preview ? 'Copy this into your own CSS and wrap the component in the scope.' : 'Copy this into your own CSS. This is a document-wide family rule; open or show the content first.'} ${recipe.steps.length} ${recipe.steps.length === 1 ? 'change' : 'changes'}: ${stepKinds.join(', ')}.`;
const nameKinds = kinds.filter(({ list }) => list.size > 0).map(({ list, one, many }) => `${list.size} ${list.size === 1 ? one : many}`).join(', ');
---

<h3 id="styling-recipe">Recipe</h3>
<p class="styling-note" data-styling-recipe-count>{recipe.steps.length > 0 ? opening : `No change was generated for ${name}.`}</p>
{recipe.notes.map((note) => <p class="styling-note" data-styling-recipe-note>{note}</p>)}
<CodeBlock id="styling-recipe-css" code={recipe.css} lang="css" label="app.css" />
<CodeBlock id="styling-recipe-markup" code={recipe.markup} lang="tsx" label="Component.tsx" plain />
{hasPreview && (
	<Fragment>
		<div class="styling-compare not-content" data-styling-compare style={`--preview-h-narrow:${reserved.narrow}px;--preview-h-wide:${reserved.wide}px`}>
			<div role="group" aria-labelledby="styling-pane-default" data-styling-pane="default">
				<h4 id="styling-pane-default">Default</h4>
				<div class="styling-frame" data-styling-scroll="Default preview">
					<div class="demo-frame">
						<ExampleHost source={source} client:only="react" />
					</div>
				</div>
			</div>
			<div role="group" aria-labelledby="styling-pane-recipe" data-styling-pane="recipe">
				<h4 id="styling-pane-recipe">With the recipe</h4>
				<style is:inline set:html={recipe.rules} data-styling-recipe-style></style>
				<div class="my-scope styling-frame" data-styling-scroll="Recipe preview">
					<div class="demo-frame">
						<ExampleHost source={source} client:only="react" />
					</div>
				</div>
			</div>
		</div>
		<h4 id="styling-computed">Computed change</h4>
		<p class="styling-note" data-styling-measure-note>Read in your browser from the two previews above for the theme you are in, once they have rendered and their transitions have settled, and again when a preview changes. A cell reads "Not measured yet." until then, and without script.</p>
		<div class="styling-scroll not-content" data-styling-scroll>
			<table class="styling-table styling-calc" data-styling-table="computed">
				<caption class="visually-hidden">{name} recipe: computed change</caption>
				<thead>
					<tr><th scope="col">Change</th><th scope="col">Before</th><th scope="col">After</th></tr>
				</thead>
				<tbody>
					{recipe.steps.map((step) => (
						<tr data-step-kind={step.kind} data-step-target={step.target} data-step-property={step.property} data-step-scope={step.scope} data-step-text={step.observedText ? 'text' : 'no-text'}>
							<th scope="row">
								<code>{step.property}</code>
								<span class="styling-sub"><code>{step.declaration}</code></span>
								<span class="styling-sub">measured on <code>{step.target}</code></span>
							</th>
							{step.scope === 'unavailable'
								? <Fragment><td data-measure="before" colspan="2">{step.reason}: the Basic example does not show it. It is measured once both previews show it.</td><td data-measure="after" hidden></td></Fragment>
								: <Fragment><td data-measure="before">Not measured yet.</td><td data-measure="after">Not measured yet.</td></Fragment>}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</Fragment>
)}
{recipe.steps.length > 0 && (
	<ul class="styling-checks" data-styling-checks>
		<li>The recipe uses {names} {names === 1 ? 'name' : 'names'} ({nameKinds}), and {names === 1 ? 'it is a row' : 'each is a row'} of the tables above.</li>
		{variables.size > 0 && <li>Every token it assigns has theme policy and is read by a rule.</li>}
		{hasRules && <li>Part and state rules sit in <code>muxui.utilities</code>, so none needs <code>!important</code>.</li>}
	</ul>
)}
<p class="styling-note" data-styling-ci>A Chromium test in the React package applies every generated recipe to the real stylesheet, in light and dark, and fails when a step does not change the property it names.</p>
