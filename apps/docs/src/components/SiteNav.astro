---
import { componentSidebar } from '../lib/catalog.ts';
import { blocksPath } from '../lib/block-paths.ts';

type Section = 'docs' | 'components' | 'blocks';

interface Props {
	/** Defaults to the section the request path belongs to. */
	current?: Section;
}

const pathname = Astro.url.pathname;
const current: Section = Astro.props.current
	?? (pathname.startsWith(blocksPath) ? 'blocks' : pathname.startsWith('/components/') ? 'components' : 'docs');
// There is no components index, so the entry opens the first component the catalog lists.
const links: readonly { section: Section; label: string; href: string }[] = [
	{ section: 'docs', label: 'Docs', href: '/' },
	{ section: 'components', label: 'Components', href: componentSidebar[0]?.items[0]?.link ?? '/' },
	{ section: 'blocks', label: 'Blocks', href: blocksPath },
];
---

<nav class="mux-site-nav" aria-label="Primary">
	<ul>
		{links.map(({ section, label, href }) => (
			<li><a href={href} aria-current={section === current ? 'page' : undefined}>{label}</a></li>
		))}
	</ul>
</nav>

<style>
	.mux-site-nav {
		flex: none;
	}

	.mux-site-nav ul {
		display: flex;
		align-items: center;
		gap: var(--muxui-reference-dimension-space-3xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mux-site-nav a {
		display: inline-flex;
		align-items: center;
		min-height: var(--muxui-semantic-control-size-md);
		padding-inline: var(--muxui-reference-dimension-space-xs);
		border-radius: var(--muxui-semantic-control-radius);
		color: var(--muxui-semantic-content-default);
		font-family: var(--muxui-semantic-typography-text-font-family);
		font-size: var(--muxui-semantic-typography-text-s-font-size);
		text-decoration: none;
	}

	.mux-site-nav a:hover {
		background: var(--muxui-semantic-surface-hover);
		color: var(--muxui-semantic-content-strong);
	}

	.mux-site-nav a:focus-visible {
		outline: 2px solid var(--muxui-semantic-focus-ring);
		outline-offset: 2px;
	}

	.mux-site-nav a[aria-current='page'] {
		color: var(--muxui-semantic-content-strong);
		box-shadow: inset 0 -2px 0 var(--muxui-semantic-content-link);
		border-end-start-radius: 0;
		border-end-end-radius: 0;
	}

	/* On a phone the site title already opens the docs home, so Docs leaves to make room. */
	@media (max-width: 30rem) {
		.mux-site-nav li:first-child { display: none; }
		.mux-site-nav a { padding-inline: var(--muxui-reference-dimension-space-3xs); }
	}

	/* The narrowest phones (320px) need a little more room for the title, the nav, and the theme picker. */
	@media (max-width: 22rem) {
		.mux-site-nav a { padding-inline: var(--muxui-reference-dimension-space-4xs); }
	}
</style>
