---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import CodeBlock from './CodeBlock.astro';
import GuideMarkup from './GuideMarkup.astro';
import { canonicalRepositoryRoot } from '../lib/catalog.ts';
import { reactCompatibilityProfile as tested } from '../lib/compatibility-profile.ts';

const packageManifest: unknown = JSON.parse(
	readFileSync(resolve(canonicalRepositoryRoot, 'packages/react/package.json'), 'utf8'),
);
const packageReadme = readFileSync(resolve(canonicalRepositoryRoot, 'packages/react/README.md'), 'utf8');

interface PackageManifest {
	name: string;
	engines: { node: string };
	peerDependencies: { react: string; 'react-dom': string };
}

function hasStrings(value: unknown, keys: readonly string[]): boolean {
	return typeof value === 'object' && value !== null && keys.every((key) => typeof Reflect.get(value, key) === 'string');
}

function isPackageManifest(value: unknown): value is PackageManifest {
	return typeof value === 'object'
		&& value !== null
		&& hasStrings(value, ['name'])
		&& hasStrings(Reflect.get(value, 'engines'), ['node'])
		&& hasStrings(Reflect.get(value, 'peerDependencies'), ['react', 'react-dom']);
}

if (!isPackageManifest(packageManifest)) {
	throw new Error('The React package manifest is missing its canonical name, engines, or peer dependencies.');
}

// The README's "## <heading>" section holds the fenced block of this language.
function readmeCode(heading: string, lang: 'sh' | 'tsx') {
	const section = packageReadme.split(/^## /mu).find((part) => part.startsWith(`${heading}\n`));
	return section?.match(new RegExp(`\`\`\`${lang}\\n([\\s\\S]*?)\`\`\``, 'u'))?.[1]?.trim();
}

const installExample = readmeCode('Install', 'sh');
const tsxExample = readmeCode('Usage', 'tsx');
const tarballExample = readmeCode('Local tarball usage', 'sh');

if (!installExample || !tsxExample || !tarballExample) {
	throw new Error('The generated React package README is missing its canonical install, usage, or local tarball examples.');
}
---

<GuideMarkup>
	<p>Install <code>{packageManifest.name}</code> from the <code>next</code> dist-tag. It requires Node.js <code>{packageManifest.engines.node}</code>, React <code>{packageManifest.peerDependencies.react}</code>, and React DOM <code>{packageManifest.peerDependencies['react-dom']}</code>.</p>

	<h2 id="install">Install</h2>

	<CodeBlock id="installation-shell-code" code={installExample} lang="bash" label="shell" />

	<p>All exports are experimental, and Mux UI makes no assistive-technology support claim. See <a href="/lifecycle/">Lifecycle</a>, <a href="/accessibility/">Accessibility</a>, and the <a href="#tested-profile">tested profile</a>.</p>

	<h2 id="usage">Usage</h2>

	<CodeBlock id="installation-usage-code" code={tsxExample} lang="tsx" label="tsx" />

	<h2 id="local-tarball">Local tarball</h2>

	<p>To develop against an unpublished build, install the versioned local candidate from the package directory instead.</p>

	<CodeBlock id="installation-tarball-code" code={tarballExample} lang="bash" label="shell" />

	<h2 id="tested-profile">Tested profile</h2>

	<p>Mux UI's automated checks run against this profile. It records what is tested, not what is supported, and every export stays experimental.</p>

	<table data-fact="compatibility.tested">
		<tbody>
			<tr><th scope="row">Runtime profile</th><td><code>{tested.runtimeProfile}</code></td></tr>
			<tr><th scope="row">Status</th><td><code>{tested.status}</code></td></tr>
			<tr><th scope="row">Node.js</th><td><code>{tested.node}</code></td></tr>
			<tr><th scope="row">React</th><td><code>{tested.react}</code></td></tr>
			<tr><th scope="row">React DOM</th><td><code>{tested.reactDom}</code></td></tr>
			<tr><th scope="row">Browser</th><td>{tested.browser}</td></tr>
			<tr><th scope="row">axe</th><td>{tested.axe}</td></tr>
			<tr><th scope="row">Browser test</th><td><a href={`https://github.com/ndrewtran/muxui/blob/main/${tested.testSource}`} target="_blank" rel="noreferrer">{tested.testSource}</a></td></tr>
		</tbody>
	</table>

	<h3 id="display-profiles">Display profiles</h3>

	<p>The browser test renders each profile, which sets color scheme, contrast, motion, density, and direction in that order.</p>

	<ul data-fact="compatibility.displayProfiles">
		{tested.displayProfiles.map((profile) => <li><code>{profile}</code></li>)}
	</ul>

	<h3 id="not-claimed">Not claimed</h3>

	<ul data-fact="compatibility.notClaimed">
		{tested.notClaimed.map((item) => <li>{item}</li>)}
	</ul>
</GuideMarkup>
