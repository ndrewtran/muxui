---
const isScalePage = Astro.url.pathname.replace(/\/+$/u, '') === '/scale';
---

<div class="mux-two-column">
	<slot />
	<aside class="right-sidebar-container print:hidden">
		<div class="right-sidebar" data-scale-toc-host={isScalePage ? '' : undefined}>
			{isScalePage ? (
				<template data-scale-toc-template>
					<slot name="right-sidebar" />
				</template>
			) : (
				<slot name="right-sidebar" />
			)}
		</div>
	</aside>
</div>
