---
interface Props {
	/** Overrides the Starlight route's title link, for pages outside Starlight. */
	href?: string;
}

const href = Astro.props.href ?? Astro.locals.starlightRoute.siteTitleHref;
---

<a href={href} class="mux-site-title">
	<span class="mux-name">Mux UI</span>
</a>

<style>
	.mux-site-title {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		color: var(--muxui-semantic-content-strong);
		font-family: var(--muxui-semantic-typography-display-font-family);
		font-weight: var(--muxui-semantic-typography-display-font-weight);
		text-decoration: none;
		white-space: nowrap;
	}

	.mux-name {
		font-size: var(--muxui-semantic-typography-label-l-font-size);
	}
</style>
