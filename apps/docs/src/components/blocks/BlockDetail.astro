---
import { Code } from 'astro:components';
import { Link, Text } from '@muxui/react';
import type { Block, BlockVariant } from '../../lib/blocks.ts';
import { previewPath, variantPath } from '../../lib/block-paths.ts';
import { toolbarPresets } from '../../lib/block-presets.ts';
import { muxCodeTheme, muxTokenPathTransformer } from '../code-theme.ts';
import BlockViewerIsland from './BlockViewerIsland.tsx';

interface Props {
	block: Block;
	variant: BlockVariant;
}

const { block, variant } = Astro.props;
const fileName = variant.sourcePath.slice(variant.sourcePath.lastIndexOf('/') + 1);
const lineCount = variant.code.trimEnd().split('\n').length;
// Astro's Shiki helper removes one terminal newline, so add it back to keep the exact bytes.
const highlighted = variant.code.endsWith('\n') ? `${variant.code}\n` : variant.code;
---

<div class="blocks-detail" data-blocks-detail>
	<BlockViewerIsland
		categoryLabel={block.categoryLabel}
		blockName={block.name}
		blockHref={variantPath(block, block.variants[0])}
		variantName={variant.name}
		summary={block.summary}
		previewSrc={previewPath(block, variant)}
		previewTitle={`${block.name}, ${variant.name} preview`}
		presets={toolbarPresets}
		fileName={fileName}
		lineCount={lineCount}
		sourcePath={variant.sourcePath}
		client:load
	>
		<Fragment slot="code">
			<Code code={highlighted} lang="tsx" theme={muxCodeTheme} transformers={[muxTokenPathTransformer]} wrap={false} />
		</Fragment>
	</BlockViewerIsland>

	<div class="blocks-meta">
		<section aria-labelledby="blocks-uses-heading">
			<Text as="h2" variant="label" size="xs" color="muted" id="blocks-uses-heading">Uses</Text>
			<ul class="blocks-inline">
				{block.participants.map((participant) => (
					<li>
						<Link href={participant.href}>{participant.name}</Link>
						<Text color="muted" size="xs">({participant.role}{participant.requirement === 'optional' ? ', optional' : ''})</Text>
					</li>
				))}
			</ul>
		</section>
		<section aria-labelledby="blocks-a11y-heading">
			<Text as="h2" variant="label" size="xs" color="muted" id="blocks-a11y-heading">Accessibility</Text>
			<ul class="blocks-notes">
				{block.accessibility.map((note) => <li><Text size="xs">{note}</Text></li>)}
			</ul>
		</section>
	</div>
</div>
