---
import { blockGroups, getBlock, usesOptions } from '../../lib/blocks.ts';
import { blockPath, blocksPath, variantPath } from '../../lib/block-paths.ts';
import BlocksRailIsland, { type RailGroup } from './BlocksRailIsland.tsx';

interface Props {
	current?: { block: string; variant: string };
}

const { current } = Astro.props;
const groups: RailGroup[] = blockGroups.map((group) => ({
	group: group.group,
	label: group.label,
	categories: group.categories.map((category) => ({
		category: category.category,
		label: category.label,
		blocks: category.blocks.map((block) => ({
			slug: block.slug,
			name: block.name,
			address: blockPath(block),
			variants: block.variants.map((variant) => ({ slug: variant.slug, name: variant.name, href: variantPath(block, variant) })),
		})),
	})),
}));
const currentBlock = current ? getBlock(current.block) : null;
const currentVariant = currentBlock?.variants.find((variant) => variant.slug === current?.variant);
const currentPath = currentBlock && currentVariant ? variantPath(currentBlock, currentVariant) : blocksPath;
---

<BlocksRailIsland groups={groups} usesOptions={usesOptions} allHref={blocksPath} currentPath={currentPath} client:load />
