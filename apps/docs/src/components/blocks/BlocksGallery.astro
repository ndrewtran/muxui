---
import { blockGroups } from '../../lib/blocks.ts';
import { previewPath, variantPath } from '../../lib/block-paths.ts';
import BlocksGalleryIsland, { type GalleryCategory } from './BlocksGalleryIsland.tsx';

const categories: GalleryCategory[] = blockGroups.flatMap((group) => group.categories).map((category) => ({
	category: category.category,
	label: category.label,
	blocks: category.blocks.map((block) => ({
		slug: block.slug,
		name: block.name,
		summary: block.summary,
		href: variantPath(block, block.variants[0]),
		previewSrc: previewPath(block, block.variants[0]),
		variantCount: block.variants.length,
	})),
}));
---

<BlocksGalleryIsland categories={categories} client:load />
