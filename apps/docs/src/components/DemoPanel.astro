---
import { Code } from 'astro:components';
import { muxCodeTheme, muxTokenPathTransformer } from './code-theme.ts';

interface Props {
	id: string;
	source: string;
	sourceCode: string;
	label?: string;
}

const { id, source, sourceCode, label = 'React example' } = Astro.props;
const sourceId = `${id}-source`;
const codeId = `${id}-code`;
const componentSlug = source.match(/^catalog\/components\/([^/]+)\//u)?.[1] ?? '';
const wideFrameComponents = new Set([
	'calendar', 'color-area', 'color-picker', 'color-slider', 'color-swatch-picker', 'color-wheel',
	'command-palette', 'dialog', 'lightbox', 'range-calendar', 'resizable', 'sidebar',
	'table', 'tabs', 'text-editor', 'toolbar', 'tree', 'virtualizer',
]);
const collectionFrameComponents = new Set(['grid-list', 'list-box', 'menu']);
const frameClasses = ['demo-frame'];
if (source.endsWith('/sizing.tsx') || wideFrameComponents.has(componentSlug)) frameClasses.push('demo-frame--wide');
if (collectionFrameComponents.has(componentSlug)) frameClasses.push('demo-frame--collection');
const frameClass = frameClasses.join(' ');
// Astro's Shiki helper removes one terminal newline, so preserve source text by adding it back at render time.
const highlightedCode = sourceCode.endsWith('\n') ? `${sourceCode}\n` : sourceCode;

---

<div class="demo-panel">
	<div class="demo-live not-content" aria-label={`${label} live demo`}>
		<div class={frameClass}>
			<slot name="live" />
		</div>
	</div>
	<div class="demo-source" id={sourceId}>
		<div class="demo-source-header">
			<span>{label}</span>
			<button type="button" data-copy-code={codeId} data-pagefind-ignore>Copy</button>
		</div>
		<div class="demo-code" id={codeId}>
			<Code code={highlightedCode} lang="tsx" theme={muxCodeTheme} transformers={[muxTokenPathTransformer]} wrap={false} />
		</div>
		<p class="demo-source-path">{source}</p>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
		if (button.dataset.copyReady) return;
		button.dataset.copyReady = 'true';
		button.addEventListener('click', async () => {
			const target = document.getElementById(button.dataset.copyCode ?? '');
			if (!target) return;
			const code = target.querySelector('code')?.textContent ?? target.textContent ?? '';
			let copied = false;
			try {
				if (navigator.clipboard) {
					await navigator.clipboard.writeText(code);
					copied = true;
				}
			} catch {
				copied = false;
			}
			if (!copied) {
				const textarea = document.createElement('textarea');
				textarea.value = code;
				textarea.setAttribute('readonly', '');
				textarea.style.position = 'fixed';
				document.body.append(textarea);
				textarea.select();
				copied = (document as unknown as { execCommand(commandId: string): boolean }).execCommand('copy');
				textarea.remove();
			}
			const original = button.textContent;
			button.textContent = copied ? 'Copied' : 'Copy failed';
			window.setTimeout(() => { button.textContent = original; }, 1200);
		});
	});
</script>
