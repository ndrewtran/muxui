{
  "name": "@muxui/scale",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../tooling/audits/repository-policy/src/prepare-prerequisites.mjs @muxui/react... && vite",
    "build": "node ../../tooling/audits/repository-policy/src/prepare-prerequisites.mjs @muxui/react... && vite build",
    "check": "node ../../tooling/audits/repository-policy/src/prepare-prerequisites.mjs @muxui/react... && node src/check.mjs",
    "check:browser": "node ../../tooling/audits/repository-policy/src/prepare-prerequisites.mjs @muxui/react... && node --test test/browser/theme-builder.test.mjs",
    "check:browser:docs": "pnpm --filter @muxui/docs build && node --test test/browser/docs-theme.test.mjs"
  },
  "dependencies": {
    "@muxui/react": "workspace:*",
    "@muxui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  }
