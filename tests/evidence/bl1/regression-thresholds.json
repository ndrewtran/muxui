{
  "schema": "muxui-bl1-regression-thresholds-v1",
  "authority": "strategy/milestone-roadmap.md: BL1 Blocks showcase, E-BL1-11",
  "fixedBeforeMeasurement": "Committed before the baseline was captured. The registry budgets are the existing command-registry.json tiers; the other numbers are judgement. The only size looked at beforehand was the seed's own source (460 and 526 lexemes), which informed the headroom of variantSourceLexemes.",
  "seedSet": ["muxui:pattern:poster-grid"],
  "discovery": {
    "metric": "precision at 3 of `search <query>`: results in the first three that are in `relevant`, divided by min(3, results returned)",
    "minimumMeanPrecisionAt3": 0.5,
    "everyQueryRanksExpectedFirst": true,
    "queries": [
      {
        "query": "poster grid",
        "expectedFirst": "muxui:pattern:poster-grid",
        "relevant": ["muxui:pattern:poster-grid", "muxui:example:poster-grid-css-grid", "muxui:example:poster-grid-virtualized"]
      },
      {
        "query": "gallery",
        "expectedFirst": "muxui:pattern:poster-grid",
        "relevant": ["muxui:pattern:poster-grid", "muxui:example:poster-grid-css-grid", "muxui:example:poster-grid-virtualized"]
      },
      {
        "query": "collections",
        "expectedFirst": "muxui:pattern:poster-grid",
        "relevant": ["muxui:pattern:poster-grid", "muxui:example:poster-grid-css-grid", "muxui:example:poster-grid-virtualized"]
      },
      {
        "query": "grid list",
        "expectedFirst": "muxui:component:grid-list",
        "relevant": ["muxui:component:grid-list", "muxui:example:grid-list-basic-react", "muxui:guide:grid-list-usage", "muxui:pattern:poster-grid", "muxui:example:poster-grid-css-grid", "muxui:example:poster-grid-virtualized"]
      },
      {
        "query": "virtualizer",
        "expectedFirst": "muxui:component:virtualizer",
        "relevant": ["muxui:component:virtualizer", "muxui:example:virtualizer-basic-react", "muxui:guide:virtualizer-usage", "muxui:pattern:poster-grid", "muxui:example:poster-grid-virtualized"]
      },
      {
        "query": "button",
        "expectedFirst": "muxui:component:button",
        "relevant": ["muxui:component:button", "muxui:example:button-basic-react", "muxui:example:button-basic-html", "muxui:example:button-states-react", "muxui:example:button-variants-react", "muxui:guide:button-usage", "muxui:pattern:poster-grid"]
      },
      {
        "query": "image",
        "expectedFirst": "muxui:component:image",
        "relevant": ["muxui:component:image", "muxui:example:image-basic-react", "muxui:pattern:poster-grid"]
      },
      {
        "query": "link",
        "expectedFirst": "muxui:component:link",
        "relevant": ["muxui:component:link", "muxui:example:link-basic-react", "muxui:example:link-icon-composition-react", "muxui:guide:link-usage", "muxui:pattern:poster-grid"]
      },
      {
        "query": "text",
        "expectedFirst": "muxui:component:text",
        "relevant": ["muxui:component:text", "muxui:example:text-basic-react", "muxui:pattern:poster-grid"]
      }
    ]
  },
  "search": {
    "maximumDisplacedComponentQueries": 0,
    "displacement": "For every component, `search <its name>` keeps the same first result with the patterns compiled in as with no pattern compiled."
  },
  "denseBudgets": {
    "registry": "The command-registry.json tokenBudgets tiers: `list pattern --limit 1` and `get <pattern>` at brief, compact, and full, and `search <query> --limit 1` at brief, compact, and full for each discovery query that expects a pattern first. Tokens are lexemes of the dense rendering (countTokens).",
    "examplesSection": {
      "command": "get <pattern> --section examples",
      "tokensPerVariant": 1000,
      "envelopeTokens": 400,
      "variantSourceLexemes": 700
    }
  }
}
